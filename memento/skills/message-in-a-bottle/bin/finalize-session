#!/usr/bin/env bash
# finalize-session: hands the current session off to a fresh one holding the message.
#
# Transports, most reliable first:
#   tmux      - schedules a worker that, after a fixed delay, clears the pane with /clear, verifies it by
#               reading the pane back, then pastes the message. The launcher returns at once.
#   iTerm2    - schedules a worker that, after the delay, kills the running claude and relaunches it with
#               the message as its initial prompt, sent with `write text` to the exact session. The
#               launcher returns at once.
#   detached  - for a session that no pane or iTerm2 session owns, such as one hosted by `claude daemon
#               run`. A worker starts a new detached tmux window running claude with the message as its
#               initial prompt, and the launcher returns only once that claude has taken the message, or
#               refuses. The worker retires the old process once the launcher has returned.
#   remote-control - for a session `claude remote-control` spawned, whose input is the server's pipe. A
#               worker posts into the session's event log on the session server, where claude.ai posts
#               prompts (lib/remote_control.py): /clear once the log shows the asking turn ended, the
#               handoff once it shows the reset, and the goal once the handoff's turn ended. The launcher
#               reads the log before it returns, so a session it cannot reach is refused, and returns at
#               once.
#
# A relaunched claude is started under a session id the launcher chooses, and it has taken the message
# when that id's transcript records a prompt holding the handoff file's path (lib/transcript.py). Nothing
# about readiness is read off a screen, whose rows a long message scrolls past.
#
# Every session can continue an autonomy chain. A launcher that cannot hand off refuses through _refuse
# (reason on stderr, exit 2). Exit 0 means the worker is scheduled (tmux, iTerm2, remote-control), whose later failures go
# to its log, or that the successor took the message (detached).
#
# Modes:
#   launcher:         see --help
#   tmux worker:      finalize-session --worker <target> <msgfile> <goalfile> [<slash-command>...]
#   iTerm2 worker:    finalize-session --iterm-worker <uuid> <claude pid> <claude ident> <msgfile> <goalfile> <relaunch line> <config dir> <successor id>
#   detached worker:  finalize-session --detached-worker <session> <cwd> <relaunch line> <config dir> <successor id> <msgfile> <goalfile> <old claude pid> <old claude ident> <launcher pid> <launcher ident> 3><verdict pipe>
#   remote worker:    finalize-session --remote-worker <session url> <log head> <msgfile> <goalfile> [<slash-command>...]

set -euo pipefail

# HANDOFF_DELAY_SECONDS is the wait before the tmux and iTerm2 workers act on the asking session's own
# pane or claude, so the asking turn has ended first. RESET_REGISTER_* bound the poll that waits for the
# reset to appear in the pane (tmux); the timeout also bounds each wait in the session's log for a
# command's effect (remote-control).
HANDOFF_DELAY_SECONDS=10
# How long the remote-control worker waits for a turn whose length is the agent's work to end: the asking
# turn, an earlier handoff's carried goal, the handoff's own turn. A day bounds a dead session. Overridable
# so tests reach the timeout quickly.
REMOTE_IDLE_TIMEOUT_SECONDS="${MEMENTO_IDLE_TIMEOUT_SECONDS:-86400}"
# The reset is typed while the agent is usually still mid-turn, and Claude runs queued input only when
# the turn ends. So the worker polls for the reset to appear instead of waiting a fixed time. The timeout
# can be overridden so tests can reach the timeout path.
RESET_REGISTER_TIMEOUT_SECONDS="${MEMENTO_RESET_TIMEOUT_SECONDS:-300}"
RESET_REGISTER_POLL_SECONDS=0.5

# The handoff file is the authoritative copy. Pasted and relaunched copies are derived from it, and they
# can be lost, but the file is not.
HANDOFF_DIR="${MEMENTO_HANDOFF_DIR:-$HOME/.claude/memento/handoffs}"
# How long a relaunched claude has to take the message (_await_prompt). The wait ends as soon as it has,
# and a timeout is a failure, never a guess that it is up. Overridable so tests reach the timeout quickly.
CLAUDE_READY_TIMEOUT_SECONDS="${MEMENTO_READY_TIMEOUT_SECONDS:-30}"
CLAUDE_READY_POLL_SECONDS=0.5

# The framing wrapped around the agent's message. The launcher joins PREFIX, the message, and SUFFIX into
# one value, and the workers pass it through unchanged.
HANDOFF_PREFIX=$(cat <<'PREFIX'
=== Below is a message from an agent on behalf of the user ===
PREFIX
)
HANDOFF_SUFFIX=$(cat <<'SUFFIX'
=== The above message was sent on behalf of the user, but as it was sent from an agent, double checking the claims is wise.  When in doubt, note any divergence and run the '/next' skill to proceed.  Do NOT ask the user if you should run '/next'. ===
SUFFIX
)

# Clears the input box before writing to it. Leftover text would fuse with the new input, so C-u is sent
# first. Escape does not clear the box.
_clear_box() {
  tmux send-keys -t "$1" C-u
  sleep 0.3
}

# Prints the process table the ancestry walk reads, one row per process: `pid ppid etime exe`, where exe
# is the executable's name as the kernel records it (ps's ucomm), read for every owner. macOS sets it
# at exec, from the file executed, so a symlink is recorded under its target's name; Linux lets a
# process rename itself, as tmux does. exe is last because it may hold spaces: Linux tmux names its
# server `tmux: server`.
#
# No argv is read for what a session was started with: that is read from its transcript, never its
# command line. The one argv the launcher reads is the own claude's, for the Remote Control session it
# names, which nothing else a tool call can see carries (the remote-control transport).
_process_table() {
  ps -eo pid=,ppid=,etime=,ucomm=
}

# Decides, from one snapshot of the tmux panes and one of the process table, what this session's ancestry
# lets a handoff reach: _ancestry <pane rows> <_process_table rows>. Pure: it reads only its arguments, $$, and
# $CLAUDE_PID, which the launcher has required. It prints three lines: the kind, the pane id, and the reason,
# which comes last because it is never empty, so the empty pane before it survives `$(...)`.
#   pane      a live pane shows this session; the pane id names it.
#   paneless  the walk reached init with no pane and no other claude, so this session owns its terminal.
#   hosted    the own claude's parent is another claude, which started it and holds its session: a
#             daemon host, or a `claude remote-control` server.
#   confined  something above this session may show another one: another claude further up (an outer
#             session this claude was started inside), a tmux server that lists no pane of this
#             session, or ancestry the walk could not establish.
#             Only a fresh detached window is safe for this or for a daemon-hosted session.
#   refused   the walk ended, however, without passing $CLAUDE_PID; the reason says how it ended.
#
# [LAW:single-enforcer] This is the one walk. The hosted decision and the pane are both read in it, hop
# by hop, under the same rules:
#   - A row that is missing, or whose elapsed time is unreadable or younger than its child's, ends the walk
#     as confined. A parent is never younger than its child, so a younger one holds a reissued pid, and
#     nothing above it is this session's ancestry. The clock has one-second resolution, so a pid reissued
#     within the same second as its child's start can still pass.
#   - The own claude is $CLAUDE_PID, which Claude Code sets for every tool call, and the walk passes it by
#     pid, whatever its executable is named.
#   - Nothing is handed off unless the walk passed the own claude. Any ending reached first is refused:
#     a pane, another claude, or init shows $CLAUDE_PID is outside this process's tree, or that no claude
#     sits below that pane, and an unsound row or the hop bound leaves $CLAUDE_PID unproven, so
#     relaunching it could signal a session that never asked.
#   - Any other claude ends the walk: directly above the own one it is the host, further above it the
#     walk is confined, and below it the walk is refused. Only a direct host is read as one, since the
#     claude further above a claude started from a hosted session's shell is that session's, not its own.
#     A claude is checked before its pane, since a pane's process is usually the claude it shows.
#   - The walk examines this process and 15 ancestors. At that bound it ends as confined.
# A wrong confinement costs a relaunch, and a wrong pane costs a /clear in someone else's session, so every
# doubt resolves to confined.
_ancestry() {
  printf '%s\n%s\n' "$1" "$2" | awk -v self=$$ -v own="$CLAUDE_PID" -v maxhops=16 '
    # ps renders elapsed time as [[dd-]hh:]mm:ss; fold it left into seconds so
    # any of the three widths compares against any other.
    function ageof(raw,   days, parts, fields, i, seconds) {
      days = 0
      if (raw ~ /-/) {
        days = substr(raw, 1, index(raw, "-") - 1) + 0
        raw = substr(raw, index(raw, "-") + 1)
      }
      fields = split(raw, parts, ":")
      seconds = 0
      for (i = 1; i <= fields; i++) seconds = seconds * 60 + parts[i] + 0
      return days * 86400 + seconds
    }
    # A claude by the executable it runs as: `claude`, nix'\''s `.claude-wrapped`, the native installer'\''s
    # versioned binary (`.../claude/versions/2.1.299` runs as `2.1.299`), or `node` for an npm install,
    # which only argv would tell apart from any other node. So every node ancestor of the session (an
    # editor'\''s node host, an orchestrator) confines it to a detached window, and a launcher started
    # through a node wrapper is refused: both are accepted losses, in the safe direction.
    function isclaude(pid) {
      return exe[pid] ~ /^(claude|\.claude-wrapped|node|[0-9]+\.[0-9]+\.[0-9]+)$/
    }
    # A tmux process by its executable: `tmux`, nix'\''s `.tmux-wrapped`, or Linux'\''s `tmux: server`.
    # A false match only confines.
    function istmux(pid) {
      return exe[pid] ~ /^\.?tmux(-wrapped)?(:|$)/
    }
    # Why the row for pid cannot stand as the parent of a process aged `younger`, or "" when it can.
    function unsound(pid, younger) {
      if (!(pid in parent)) return "process " pid " has no row in the process table"
      if (elapsed[pid] !~ /^([0-9]+-)?([0-9]+:)?[0-9]+:[0-9][0-9]$/)
        return "the elapsed time of process " pid " cannot be read"
      if (ageof(elapsed[pid]) < younger)
        return "process " pid " is younger than its child, so its pid was reissued"
      return ""
    }
    # Every ending passes through here, so the rule a handoff needs is kept once: nothing is handed off
    # unless the walk passed the own claude, whatever ended it.
    function answer(kind, pane, reason) {
      if (!passed) {
        reason = "the ancestry walk never passed $CLAUDE_PID " own \
                 ", so nothing it reached is this session'\''s to hand off: " reason
        kind = "refused"; pane = ""
      }
      printf "%s\n%s\n%s\n", kind, pane, reason
      exit 0
    }
    # tmux labels its own rows with a literal "pane", so one pass tells the two snapshots apart. A row
    # counts only if it positively reports the pane alive: tmux renders an unknown format field as empty,
    # so a tmux without #{pane_dead} matches no pane.
    $1 == "pane" { if (NF == 4 && $4 == "0") pane[$3] = $2; next }
    NF >= 4 {
      parent[$1] = $2
      elapsed[$1] = $3
      exe[$1] = $4
      for (i = 5; i <= NF; i++) exe[$1] = exe[$1] " " $i
    }
    END {
      passed = 0
      pid = self
      younger = -1
      for (hop = 0; hop < maxhops; hop++) {
        why = unsound(pid, younger)
        if (why != "") answer("confined", "", why)
        # Compared as strings: awk compares two numeric-looking strings as numbers, so `0300` would
        # match pid 300.
        if (pid "" == own "") passed = 1
        else if (isclaude(pid))
          answer(below "" == own "" ? "hosted" : "confined", "",
                 !passed ? "it met claude process " pid " first" \
                 : below "" == own "" ? "hosted by another claude (process " pid ")" \
                 : "another claude (process " pid ") is further up")
        if (pid in pane) answer("pane", pane[pid], "process " pid " is the process of pane " pane[pid])
        # A pane process sits directly below its tmux server, so reaching the server means tmux listed
        # no live pane of this session: whatever terminal shows it, that terminal does not belong to this session.
        if (istmux(pid)) answer("confined", "", "tmux process " pid " is above this session, but tmux lists no live pane of it")
        younger = ageof(elapsed[pid])
        below = pid
        pid = parent[pid]
        if (pid + 0 <= 1) break
      }
      if (hop == maxhops) answer("confined", "", "the walk ended at its " maxhops "-hop bound without a pane")
      answer("paneless", "", "the walk reached init without a pane")
    }'
}

# Sets CLAUDE_IDENT and FLAGS for the own claude, or refuses in the named transport's voice. A claude that is
# not an interactive session (headless, a subcommand, a daemon host) is refused, since relaunching it would
# sever its client or kill every session it hosts. Claude Code sets $CLAUDE_CODE_ENTRYPOINT to `cli` only
# for an interactive session: a `claude -p` started with `cli` inherited reports `sdk-cli` (2.1.299).
#
# FLAGS is the permission mode and effort the session's transcript records last, as the reader in
# lib/transcript.py renders them. The relaunch keeps nothing else of the old session.
#
# The identity is captured at the same instant as the pid and passed on as data. The worker compares against
# it before signaling, since by then the pid may belong to another process. A pid that cannot be identified
# is never signaled, so this is a hard stop.
_relaunch_target() { # <transport name>
  [[ "${CLAUDE_CODE_ENTRYPOINT:-}" == cli ]] \
    || _refuse "$1: claude process $CLAUDE_PID is not an interactive session (\$CLAUDE_CODE_ENTRYPOINT is '${CLAUDE_CODE_ENTRYPOINT:-}', not cli)"
  [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] \
    || _refuse "$1: \$CLAUDE_CODE_SESSION_ID is unset, so no transcript can say what this session runs in"
  # The reader names on stderr what the transcript lacks; the refusal follows it. -I keeps the user's
  # PYTHONPATH and site-packages out of the read, since the reader needs only the standard library.
  FLAGS=$(python3 -I "$READER" flags "$CONFIG_DIR" "$CLAUDE_CODE_SESSION_ID") \
    || _refuse "$1: cannot read the permission mode to relaunch with from session $CLAUDE_CODE_SESSION_ID's transcript"
  CLAUDE_IDENT=$(_process_identity "$CLAUDE_PID") \
    || _refuse "$1: cannot read the identity of claude process $CLAUDE_PID"
}

# Returns what a pid holds, as its start time and executable name. Those survive the pid being reissued.
# Empty output means the pid holds nothing, and that is a failure to identify.
#
# A pid alone does not identify a process, since the kernel can reissue it after its holder exits. Start
# time tells the two apart. The detached worker signals a pid up to about 41 seconds after capturing it, so
# this check is as strict as the ancestry walk's pid-reuse guard.
_process_identity() {
  local pid="${1:-}" raw
  [ -n "$pid" ] || return 1
  raw=$(ps -o lstart=,ucomm= -p "$pid" 2>/dev/null) || return 1
  [ -n "$raw" ] || return 1
  printf '%s' "$raw"
}

# Answers whether a pid still holds the process captured at launch. `kill -0` is not enough, since it
# only shows that some process is alive at the pid. Every check in the retirement sequence (the gate, the
# poll, and the KILL escalation) uses this, because TERM frees the pid for reuse during the poll.
#
# The reading is left in IDENT_NOW, so the caller reports the value its check used.
_still_captured_process() { # <pid> <identity captured at launch>
  IDENT_NOW=$(_process_identity "$1") || { IDENT_NOW=""; return 1; }
  [[ "$IDENT_NOW" == "$2" ]]
}

# Retires the claude captured at launch, TERM first and KILL if it lingers. Both relaunching workers use
# this, so neither signals a pid that no longer holds the captured process. Reports through the worker's log.
_retire() { # <pid> <identity captured at launch>
  if _still_captured_process "$1" "$2"; then
    kill -TERM "$1" 2>/dev/null || true
    # The poll stops when the captured process has exited or the pid holds another process.
    for _ in $(seq 1 20); do
      _still_captured_process "$1" "$2" || break
      sleep 0.5
    done
    if _still_captured_process "$1" "$2"; then
      log "old claude $1 survived TERM; sending KILL"
      kill -KILL "$1" 2>/dev/null || true
    fi
    log "old claude $1 terminated"
  else
    log "old claude $1 is gone: pid now holds [${IDENT_NOW:-nothing}], not the process captured at launch [$2]. Nothing to retire."
  fi
}

# The command line every relaunch runs: _relaunch_line <claude> <successor id>. It states this session's
# config dir, set or unset, since a tmux server or a login shell may carry another one, and the successor's
# transcript must be where _await_prompt reads. Setting it to ~/.claude when it is unset is not the same:
# it moves where claude reads .claude.json. Then claude under the chosen session id, the recorded and
# requested flags, and the handoff read from its file. Each piece is shell-quoted, so a path containing a
# quote cannot break the line. The variable is set in a subshell rather than through env(1), which would
# look claude up on PATH and skip an alias or function the iTerm2 session's shell defines for it.
_relaunch_line() {
  local env bin msg
  if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then
    printf -v env 'export CLAUDE_CONFIG_DIR=%q' "$CLAUDE_CONFIG_DIR"
  else
    env='unset CLAUDE_CONFIG_DIR'
  fi
  printf -v bin '%q' "$1"
  printf -v msg '%q' "$MSGFILE"
  printf '%s' "($env; $bin --session-id $2 ${FLAGS:+$FLAGS }\"\$(cat $msg)\")"
}

# A fresh session id for a successor, lowercase as claude writes its own. uuidgen prints uppercase and is
# not on every Linux; python3 is already required by the reader.
_successor_id() {
  python3 -I -c 'import uuid; print(uuid.uuid4())'
}

# Waits until a relaunched claude has taken the message: _await_prompt <config dir> <session id> [<tmux
# session>]. Returns 0 once the session's transcript records a prompt holding the handoff file's path,
# which every handoff message ends with, so it is this message and not another. Returns 1 with WHY_NOT
# set when the reader cannot tell, when the tmux session's claude has exited, or at the timeout.
_await_prompt() {
  local deadline=$(( $(date +%s) + CLAUDE_READY_TIMEOUT_SECONDS )) status pane dead signal
  while :; do
    status=0
    WHY_NOT=$(python3 -I "$READER" prompted "$1" "$2" "$MSGFILE" 2>&1) || status=$?
    case "$status" in
      0) return 0 ;;
      1) ;;
      *) WHY_NOT="the transcript reader cannot tell whether it did: $WHY_NOT"; return 1 ;;
    esac
    # remain-on-exit keeps a dead claude's pane, so its exit is seen at once and its last words stay
    # readable.
    if [[ -n "${3:-}" ]]; then
      # tmux sets the status for an exit and the signal for a kill, never both. The fields are split
      # on `:`, since whitespace splitting would merge the empty one away.
      pane=$(tmux display-message -p -t "$3" '#{pane_dead}:#{pane_dead_status}:#{pane_dead_signal}' 2>&1) \
        || { WHY_NOT="tmux cannot read session $3: $pane"; return 1; }
      IFS=: read -r dead status signal <<<"$pane"
      [[ "$dead" != 1 ]] \
        || { WHY_NOT="claude exited${status:+ with status $status}${signal:+ on signal $signal} before taking it"; return 1; }
    fi
    [[ $(date +%s) -lt $deadline ]] \
      || { WHY_NOT="it was not taken within ${CLAUDE_READY_TIMEOUT_SECONDS}s"; return 1; }
    sleep "$CLAUDE_READY_POLL_SECONDS"
  done
}

# Refuses the run with a reason: _refuse <reason>. Exits 2, and names the handoff's path if one was recorded.
# RECORDED is empty until the handoff is written, and is always interpolated, so the message is correct on
# either side of the write.
_refuse() {
  echo "finalize-session: $1${RECORDED:+
The handoff was NOT delivered. It is preserved at: $RECORDED}" >&2
  exit 2
}

# Makes a temp file or refuses: _mktemp_or_exit <varname> <purpose>. The result is assigned through the
# caller's variable, so the exit belongs to this script. `mktemp -t` ignores $TMPDIR on macOS, so the
# refusal names the purpose and no directory.
_mktemp_or_exit() {
  local __var="$1" purpose="$2" path
  path=$(mktemp -t "finalize-$purpose.XXXXXX") \
    || _refuse "cannot create the $purpose tempfile."
  printf -v "$__var" '%s' "$path"
}

# Appends the requested model and effort to FLAGS, so the relaunched claude starts on them. They come after the
# flags the transcript records, so a requested --effort overrides the recorded one: claude takes the last of a
# repeated flag (checked on 2.1.299: `claude --effort low --effort bogus` warns that bogus is unknown, so bogus is the one read).
_requested_flags() {
  local extra=""
  [[ -n "$MODEL" ]] && extra+="$(printf '%q %q ' --model "$MODEL")"
  [[ -n "$EFFORT" ]] && extra+="$(printf '%q %q ' --effort "$EFFORT")"
  FLAGS="${FLAGS:+$FLAGS }${extra% }"
  FLAGS="${FLAGS% }"
}

# Refuses a --model/--effort value that cannot be one word: _setting_value <flag> <value>. The value is typed into
# a slash command or appended to a relaunch line, so a missing argument that swallowed the next flag, or a value
# with whitespace, would become a different command.
_setting_value() {
  case "$2" in
    ''|-*|*[[:space:]]*)
      echo "$1 requires a single-word value, got '$2'" >&2
      exit 2 ;;
  esac
}

# The usage text. The header's Modes block refers to it.
_usage() {
  cat <<'USAGE'
finalize-session — record the session handoff and reset the session into it.

usage: finalize-session [--goal <condition>] [--model <model>] [--effort <level>]
                        [--] [message...]

  --goal <condition>      re-issue an active /goal into the reset session, which
                          otherwise wakes with no goal and stops an unattended run
  --model <model>         start the next session on this model; omit to leave the
                          model as the transport leaves it
  --effort <level>        start the next session at this effort level; omit to
                          leave it as the transport leaves it
  --                      end flag parsing; every token after it is message text
  message...              what the next agent wakes up holding (default: /next)

  FINALIZE_DRY_RUN=1      report the transport it would use; schedule nothing
  MEMENTO_HANDOFF_DIR     where the handoff is written
                          (default: ~/.claude/memento/handoffs)

Every flag here has two dashes, so only a two-dash word is read as one. Anything
else is message: -h, "- shipped the parser", any argument carrying a newline.

exit: 0 it did what you asked · 2 it could not — argv, setup, or transport
USAGE
}

# Resolves own path for both ./script and PATH-lookup invocations, once for every mode: the launcher
# re-invokes itself as a worker, and every mode reads the transcript reader beside it.
if [[ "$0" == */* ]]; then
  SELF_RAW="$0"
else
  SELF_RAW=$(command -v -- "$0") \
    || _refuse "cannot resolve own path from \$0=$0"
fi
# Split into two assignments: in one assignment only the last command's status counts, so a failed `cd`
# would go unnoticed and leave SELF malformed.
# Resolved through symlinks, since the reader is found relative to the launcher's real directory.
SELF_RAW=$(readlink -f -- "$SELF_RAW") \
  || _refuse "cannot resolve own directory from \$0=$0"
SELFDIR=$(cd "$(dirname "$SELF_RAW")" && pwd) \
  || _refuse "cannot resolve own directory from \$0=$0"
SELF="$SELFDIR/$(basename "$SELF_RAW")"
READER="$SELFDIR/../../../lib/transcript.py"
REMOTE="$SELFDIR/../../../lib/remote_control.py"

# Selects the mode once, from the first argument.
case "${1:-}" in
  --worker)          MODE=tmux-worker; shift ;;
  --iterm-worker)    MODE=iterm-worker; shift ;;
  --detached-worker) MODE=detached-worker; shift ;;
  --remote-worker)   MODE=remote-worker; shift ;;
  *)                 MODE=launcher ;;
esac

case "$MODE" in

  launcher)
    # A leading --goal <condition> is stripped here, so the rest is the message. /clear and a fresh relaunch
    # both drop the session's /goal, so it is re-issued into the new session. An absent goal is an empty string.
    GOAL=""
    # --model and --effort are set only when the caller asks. Empty means the transport's own behavior stands.
    MODEL=""
    EFFORT=""
    # A literal newline, for matching inside a case pattern below.
    NEWLINE=$'\n'
    while :; do
      case "${1:-}" in
        --goal)
          GOAL="${2:-}"
          shift 2 || { echo "--goal requires a condition argument" >&2; exit 2; }
          ;;
        --model)
          _setting_value --model "${2:-}"; MODEL="$2"
          shift 2 ;;
        --effort)
          _setting_value --effort "${2:-}"; EFFORT="$2"
          shift 2 ;;
        --help)
          _usage; exit 0 ;;
        # `--` ends flag parsing, so a handoff that must start with `--` can still be sent.
        --)
          shift; break ;;
        # A token containing a newline is message text, since no flag spans a line.
        --*"$NEWLINE"*)
          break ;;
        # Only two-dash words are flags. An unknown one is refused rather than sent as the handoff, so a typo
        # such as `--rest compact` is not delivered as text. A single-dash token such as `-h` is message text.
        --*)
          echo "unknown flag '$1' — finalize-session --help lists what it takes." >&2
          echo "To send it as handoff text, put it after --." >&2
          exit 2 ;;
        *) break ;;
      esac
    done

    # The message defaults to /next when no arguments are given.
    AGENT_MESSAGE="${*:-/next}"
    # [LAW:one-source-of-truth] Where this session's transcript is, and so where a successor started with
    # this session's environment writes its own. The flags read and every readiness wait use this value.
    CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

    # The message is passed between processes as a file, so no shell quoting is involved. The file is kept
    # after delivery, since it is the handoff itself.

    # Empty until the handoff is on disk. Every refusal below reads it.
    RECORDED=""
    # _refuse is the exit for every give-up. The ERR trap routes an unexpected failing command into _refuse.
    # The trap fires only on a failing command, so an assignment that swallows its own failure is checked by
    # hand (see SELFDIR below). Condition contexts such as `a || b` and `if` are exempt, so the transport
    # probes below can fall through.
    trap '_refuse "unexpected failure at line $LINENO: $BASH_COMMAND"' ERR
    mkdir -p -- "$HANDOFF_DIR" \
      || _refuse "cannot create handoff directory $HANDOFF_DIR"
    MSGFILE="$HANDOFF_DIR/$(date -u '+%Y%m%dT%H%M%SZ')-$$.md"

    # The wrapped message is built once and includes the handoff file's path, so every copy points to the
    # full text on disk. It also names the session that wrote it and says what the id is for, since the agent
    # that reads it never reads this skill. Claude Code exports the id to every tool call; a run without it
    # still hands off, saying the id is missing. [LAW:no-silent-failure] The path stays the last line.
    if [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
      SENT_FROM="Sent from Claude Code session $CLAUDE_CODE_SESSION_ID; its transcript is the record to check this message's claims against."
    else
      SENT_FROM="Sent from a Claude Code session whose id was not in the environment (CLAUDE_CODE_SESSION_ID unset or empty)."
    fi
    MESSAGE=$(printf '%s\n%s\n%s\n\n%s\nThis handoff verbatim on disk: %s' \
      "$HANDOFF_PREFIX" "$AGENT_MESSAGE" "$HANDOFF_SUFFIX" "$SENT_FROM" "$MSGFILE")

    _mktemp_or_exit GOALFILE goal
    LOGFILE=""
    # The EXIT trap removes transient files only. The handoff file is kept.
    trap 'rm -f -- "$GOALFILE" ${LOGFILE:+"$LOGFILE"}' EXIT
    # $RECORDED stays empty until the write succeeds, so a half-written file is never reported as the handoff.
    printf '%s' "$MESSAGE" > "$MSGFILE" \
      || _refuse "cannot write the handoff to $MSGFILE"
    RECORDED="$MSGFILE"
    # The goal is passed as a file value, empty when none was carried. Workers re-issue /goal only when it is non-empty.
    printf '%s' "$GOAL" > "$GOALFILE" \
      || _refuse "cannot write the carried goal to $GOALFILE"

    # The tmux transport types these into the reset session before the handoff prompt, so the handoff's first turn
    # already runs on them. The relaunching transports pass them as claude flags instead. Empty when neither was
    # requested.
    SETTING_COMMANDS=()
    [[ -n "$MODEL" ]] && SETTING_COMMANDS+=("/model $MODEL")
    [[ -n "$EFFORT" ]] && SETTING_COMMANDS+=("/effort $EFFORT")

    # A handoff always resets the session. The next session starts blank and holds only the message.

    # Transport detection runs once, here. Each worker receives the result as a typed value and does not
    # re-detect.
    #
    # [LAW:effects-at-boundaries] The process table and the panes are each read once, here, and _ancestry
    # decides every transport question but one from those two readings: the own claude's command line,
    # read once below, names the Remote Control session it is, if any. No tmux binary, or no server, means no
    # panes. The environment's $TMUX_PANE is never read: it is inherited, so a daemon passes its spawner's
    # down, and a pane the walk did not reach is not this session's whatever the environment says.
    [[ -n "${CLAUDE_PID:-}" ]] \
      || _refuse "\$CLAUDE_PID is unset, so the ancestry walk cannot tell this session's claude from any other"
    PROCS=$(_process_table) \
      || _refuse "cannot read the process table, so no transport can be shown to be this session's"
    PANES=$(tmux list-panes -a -F 'pane #{pane_id} #{pane_pid} #{pane_dead}' 2>/dev/null) || PANES=""
    # Captured before it is read, since a substitution inside a redirection escapes the ERR trap.
    WALK=$(_ancestry "$PANES" "$PROCS")
    { IFS= read -r KIND; IFS= read -r PANE; IFS= read -r REASON; } \
      <<<"$WALK"
    [[ -z "${FINALIZE_DRY_RUN:-}" ]] || echo "[dry-run] ancestry: $KIND, $REASON"
    [[ "$KIND" != refused ]] || _refuse "$REASON"
    # [LAW:one-source-of-truth] The session's URL on the session server is in one place a tool call can
    # read: the --sdk-url the server started this session's claude with. The walk proved $CLAUDE_PID is
    # that claude. The environment's CLAUDE_CODE_ENVIRONMENT_KIND is never read: it is inherited, so a
    # daemon started from a remote-control session's shell passes it down to sessions that are not one.
    ARGS=$(ps -ww -o args= -p "$CLAUDE_PID") \
      || _refuse "cannot read the command line of claude process $CLAUDE_PID"
    REMOTE_SESSION=$(python3 -I "$REMOTE" session "$ARGS") \
      || _refuse "cannot tell which Remote Control session claude process $CLAUDE_PID is"
    # A claude started with a Remote Control session's URL takes its input from that session's stream, so
    # no pane or relaunch reaches it, whatever sits above it: its prompts come through its log on the
    # session server. `claude remote-control` starts such a claude as its direct child (hosted).
    if [[ -n "$REMOTE_SESSION" ]]; then
      # [LAW:no-ambient-temporal-coupling] Nothing is posted during this turn: a prompt posted now can be
      # handed to this turn as text at its next tool call, so a /clear would be read, not run. The worker
      # waits for the turn's end from the log's last event now.
      # Reading it here puts a refusal (no login, a 401 or 403) in front of the agent that asked, in a dry
      # run too.
      HEAD=$(python3 -I "$REMOTE" head "$REMOTE_SESSION") \
        || _refuse "remote-control transport: cannot read the log of $REMOTE_SESSION"
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=remote-control session=$REMOTE_SESSION log_head=$HEAD msgfile=$MSGFILE"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        echo "[dry-run] requested model: ${MODEL:-(none)} effort: ${EFFORT:-(none)}"
        exit 0
      fi
      _mktemp_or_exit LOGFILE log
      nohup "$SELF" --remote-worker "$REMOTE_SESSION" "$HEAD" "$MSGFILE" "$GOALFILE" \
        ${SETTING_COMMANDS[@]+"${SETTING_COMMANDS[@]}"} </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → remote-control session $REMOTE_SESSION: /clear and the handoff are posted once this turn ends (log: $LOGFILE)"

    # The pane id is the target: tmux keeps it for the pane's life, where a session:window.pane index can
    # shift before the worker wakes.
    elif [[ "$KIND" == pane ]]; then
      TARGET="$PANE"
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=tmux target=$TARGET msgfile=$MSGFILE"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        echo "[dry-run] requested model: ${MODEL:-(none)} effort: ${EFFORT:-(none)}"
        exit 0
      fi
      _mktemp_or_exit LOGFILE log
      nohup "$SELF" --worker "$TARGET" "$MSGFILE" "$GOALFILE" ${SETTING_COMMANDS[@]+"${SETTING_COMMANDS[@]}"} \
        </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → tmux $TARGET in ${HANDOFF_DELAY_SECONDS}s (log: $LOGFILE)"

    # $ITERM_SESSION_ID is inherited like $TMUX_PANE, so it names this session's terminal only when the walk
    # showed nothing above this session that could own it.
    elif [[ "$KIND" == paneless && "${TERM_PROGRAM:-}" == "iTerm.app" && -n "${ITERM_SESSION_ID:-}" ]] \
         && osascript -e 'tell application "iTerm2" to get version' >/dev/null 2>&1; then
      UUID="${ITERM_SESSION_ID#*:}"
      _relaunch_target "iTerm2 transport"
      _requested_flags
      SUCCESSOR_ID=$(_successor_id) \
        || _refuse "iTerm2 transport: cannot mint a session id for the relaunch"
      RELAUNCH=$(_relaunch_line claude "$SUCCESSOR_ID")
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=iTerm2 uuid=$UUID claude_pid=$CLAUDE_PID flags=[$FLAGS]"
        echo "[dry-run] would relaunch: $RELAUNCH"
        echo "[dry-run] old-process identity: $CLAUDE_IDENT"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        exit 0
      fi
      _mktemp_or_exit LOGFILE log
      nohup "$SELF" --iterm-worker "$UUID" "$CLAUDE_PID" "$CLAUDE_IDENT" "$MSGFILE" "$GOALFILE" "$RELAUNCH" \
        "$CONFIG_DIR" "$SUCCESSOR_ID" </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → iTerm2 (kill+relaunch, fresh) in ${HANDOFF_DELAY_SECONDS}s (log: $LOGFILE)"

    elif command -v tmux >/dev/null 2>&1; then
      # No owned pane and no reachable iTerm2 session, as with a session hosted by `claude daemon run`.
      # `new-session -d` starts a tmux server if none is running. The process retired is $CLAUDE_PID, as for
      # the iTerm2 transport.
      _relaunch_target "detached transport"
      _requested_flags
      # A fresh detached window starts a login shell that may rebuild PATH, so the absolute path is resolved
      # here and passed down as data. An unresolvable `claude` is a refusal, not a fallback to a bare name.
      CLAUDE_BIN=$(command -v claude) \
        || _refuse "detached transport: 'claude' is not resolvable on PATH; cannot name what to relaunch"
      CWD=$(pwd -P)
      # tmux session names cannot contain ':' or '.'. The pid and epoch seconds are digits only.
      SESSION="finalize-$$-$(date +%s)"
      SUCCESSOR_ID=$(_successor_id) \
        || _refuse "detached transport: cannot mint a session id for the relaunch"
      RELAUNCH=$(_relaunch_line "$CLAUDE_BIN" "$SUCCESSOR_ID")
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=detached session=$SESSION cwd=$CWD claude_pid=$CLAUDE_PID claude_bin=$CLAUDE_BIN flags=[$FLAGS]"
        echo "[dry-run] would launch: $RELAUNCH in a fresh detached tmux window"
        echo "[dry-run] old-process identity: $CLAUDE_IDENT"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        exit 0
      fi
      _mktemp_or_exit LOGFILE log
      LAUNCHER_IDENT=$(_process_identity $$) \
        || _refuse "detached transport: cannot read this launcher's own identity, which the worker waits on"
      # The worker reads the goal and writes to the log after this launcher exits, so they are its own.
      trap - EXIT
      # [LAW:single-enforcer] The worker is the successor's one owner, from its spawn to the old process's
      # retirement; this launcher only reports the verdict it sends. Claude Code kills a stopped Bash
      # call's process tree by parentage, and nohup guards only against hangup, so the worker is
      # double-forked: the substitution's subshell exits at once and leaves it outside the tree, alive
      # whatever happens to this call.
      # [LAW:no-ambient-temporal-coupling] The verdict comes over the substitution's pipe, on the worker's
      # fd 3, and the substitution ends at that pipe's EOF, which comes when the worker closes it after its
      # verdict or dies without one. No clock and no liveness poll here: the worker's deadline is the one
      # bound on the wait.
      VERDICT=$(nohup "$SELF" --detached-worker "$SESSION" "$CWD" "$RELAUNCH" "$CONFIG_DIR" "$SUCCESSOR_ID" \
        "$MSGFILE" "$GOALFILE" "$CLAUDE_PID" "$CLAUDE_IDENT" "$$" "$LAUNCHER_IDENT" \
        3>&1 </dev/null >>"$LOGFILE" 2>&1 &)
      # An empty verdict is a worker that died without one, which the case below names.
      { IFS= read -r OUTCOME || OUTCOME=""; DETAIL=$(cat); } <<<"$VERDICT"
      case "${OUTCOME:-}" in
        taken)
          echo "handoff delivered → session $SUCCESSOR_ID in detached tmux window '$SESSION'; this session is retired once this call returns (log: $LOGFILE)" ;;
        refused)
          _refuse "detached transport: $DETAIL" ;;
        *)
          _refuse "detached transport: the worker exited without a verdict, so whether the successor in detached tmux window '$SESSION' took the message is unknown; its log is $LOGFILE" ;;
      esac

    else
      # Nothing can deliver the handoff: no owned pane, no reachable iTerm2 session, and no tmux binary. The
      # handoff is already on disk, so the refusal names its path. The nonzero exit tells the caller the
      # close-out did not happen. The walk's reason says why no pane or iTerm2 session could be used.
      _refuse "no owned tmux pane and no reachable iTerm2 session ($REASON), and no tmux binary to start a detached window with.
Nothing on this machine to deliver the close-out into."
      # GOALFILE cleaned by the EXIT trap; MSGFILE deliberately kept.
    fi
    ;;

  tmux-worker)
    if [[ $# -lt 3 ]]; then
      echo "internal error: worker expects at least 3 args" >&2
      exit 2
    fi
    TARGET="$1"
    MSGFILE="$2"
    GOALFILE="$3"
    shift 3

    BUFFER="finalize-$$"
    GOALBUF="finalize-goal-$$"
    trap 'rm -f "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    # The banner a fresh session prints; seeing it is what confirms /clear landed.
    REGISTERED_RE='Claude Code v[0-9]'

    log "waking; target=$TARGET"
    sleep "$HANDOFF_DELAY_SECONDS"

    tmux send-keys -t "$TARGET" Escape
    sleep 1
    _clear_box "$TARGET"
    tmux send-keys -t "$TARGET" "/clear"
    sleep 0.5
    tmux send-keys -t "$TARGET" Enter

    # Polls for the reset to appear, up to the timeout. The poll count is integer arithmetic, since bash 3.2
    # (the /bin/bash on macOS) has no floats.
    POLL_BUDGET=$(awk "BEGIN{printf \"%d\", $RESET_REGISTER_TIMEOUT_SECONDS / $RESET_REGISTER_POLL_SECONDS}")
    POLLS=0
    OBSERVED="WARNING: not observed within ${RESET_REGISTER_TIMEOUT_SECONDS}s"
    while :; do
      if tmux capture-pane -t "$TARGET" -p | grep -qE "$REGISTERED_RE"; then
        OBSERVED="registered after $(awk "BEGIN{printf \"%.1f\", $POLLS * $RESET_REGISTER_POLL_SECONDS}")s"
        break
      fi
      [[ "$POLLS" -ge "$POLL_BUDGET" ]] && break
      sleep "$RESET_REGISTER_POLL_SECONDS"
      POLLS=$((POLLS + 1))
    done

    # The handoff is sent whether or not the reset was seen; the poll result only goes into the log. tmux
    # type-ahead keeps input in order, so the handoff lands after the queued reset either way.
    log "/clear $OBSERVED; sending handoff (preserved at $MSGFILE)"

    # The requested /model and /effort go in before the handoff, while the reset session's box is idle, so the
    # handoff's first turn already runs on them. Each value is a single word, so typing it literally is safe.
    for SETTING in "$@"; do
      log "setting $SETTING"
      _clear_box "$TARGET"
      tmux send-keys -t "$TARGET" -l "$SETTING"
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter
      sleep 1
    done

    _clear_box "$TARGET"
    tmux load-buffer -b "$BUFFER" "$MSGFILE"
    tmux paste-buffer -d -b "$BUFFER" -t "$TARGET" -p
    sleep 0.5
    tmux send-keys -t "$TARGET" Enter

    # The goal is queued after the handoff prompt, so it does not race the handoff turn. /clear wiped it.
    if [[ -s "$GOALFILE" ]]; then
      log "re-establishing carried goal"
      sleep 1
      _clear_box "$TARGET"
      { printf '/goal '; cat "$GOALFILE"; } | tmux load-buffer -b "$GOALBUF" -
      tmux paste-buffer -d -b "$GOALBUF" -t "$TARGET" -p
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter
    fi
    ;;

  iterm-worker)
    if [[ $# -ne 8 ]]; then
      echo "internal error: iterm-worker expects exactly 8 args" >&2
      exit 2
    fi
    UUID="$1"
    CLAUDE_PID="$2"
    CLAUDE_IDENT="$3"
    MSGFILE="$4"
    GOALFILE="$5"
    RELAUNCH="$6"
    CONFIG_DIR="$7"
    SUCCESSOR_ID="$8"

    trap 'rm -f "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    log "waking; iterm uuid=$UUID claude_pid=$CLAUDE_PID relaunch=[$RELAUNCH]"
    sleep "$HANDOFF_DELAY_SECONDS"

    # Stop the running claude so the shell regains the session.
    _retire "$CLAUDE_PID" "$CLAUDE_IDENT"

    # Let the shell draw its prompt before typing into it.
    sleep 2

    # The shell reads the message from MSGFILE, so no message text enters argv or AppleScript. Only \ and "
    # are escaped for AppleScript.
    AS=${RELAUNCH//\\/\\\\}
    AS=${AS//\"/\\\"}

    if osascript <<OSA 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${UUID}" then
          write s text "${AS}"
          return
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA
    then
      log "relaunch command sent to iTerm2 session $UUID"
      # Re-queues the carried goal, which the relaunch wiped. It is sent only when the goal file is non-empty.
      if [[ -s "$GOALFILE" ]]; then
        log "waiting for relaunched claude $SUCCESSOR_ID to take the message (up to ${CLAUDE_READY_TIMEOUT_SECONDS}s)"
        if ! _await_prompt "$CONFIG_DIR" "$SUCCESSOR_ID"; then
          log "ERROR: relaunched claude in session $UUID did not take the message: $WHY_NOT; carried goal NOT delivered. Deliver it manually once the session is up: /goal $(cat "$GOALFILE")"
        else
          # The message is taken and its turn is running; the goal is queued behind it.
          log "claude took the message; re-establishing carried goal"
          GOALCMD="/goal $(cat "$GOALFILE")"
          GAS=${GOALCMD//\\/\\\\}
          GAS=${GAS//\"/\\\"}
          if osascript <<OSA2 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${UUID}" then
          write s text "${GAS}"
          return
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA2
          then
            log "carried goal re-established in iTerm2 session $UUID"
          else
            log "ERROR: could not re-establish carried goal in session $UUID"
          fi
        fi
      fi
    else
      log "ERROR: could not write relaunch to iTerm2 session $UUID"
    fi

    # Give the shell time to read the message file before this worker exits.
    sleep 3
    ;;

  detached-worker)
    if [[ $# -ne 11 ]]; then
      echo "internal error: detached-worker expects exactly 11 args" >&2
      exit 2
    fi
    { true >&3; } 2>/dev/null \
      || { echo "internal error: detached-worker expects the launcher's verdict pipe on fd 3" >&2; exit 2; }
    SESSION="$1"
    CWD="$2"
    RELAUNCH="$3"
    CONFIG_DIR="$4"
    SUCCESSOR_ID="$5"
    MSGFILE="$6"
    GOALFILE="$7"
    OLD_CLAUDE_PID="$8"
    OLD_CLAUDE_IDENT="$9"
    LAUNCHER_PID="${10}"
    LAUNCHER_IDENT="${11}"

    GOALBUF="finalize-goal-$$"
    trap 'rm -f "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
    # The verdict the launcher reports: an outcome line, `taken` or `refused`, then the reason. Closing
    # fd 3 is the launcher's EOF. A launcher that is gone fails the write with EPIPE, ignored here so it
    # cannot kill the worker: the worker still decides, and the log says no one heard.
    _verdict() {
      ( trap '' PIPE; printf '%s\n' "$@" >&3 ) 2>/dev/null \
        || log "the launcher is gone, so no one heard the verdict: $1"
      exec 3>&-
    }

    log "waking; detached session=$SESSION successor=$SUCCESSOR_ID cwd=$CWD old_claude_pid=$OLD_CLAUDE_PID relaunch=[$RELAUNCH]"

    # The new window's shell reads the message from the file, so the message never reaches argv or tmux
    # quoting. remain-on-exit is set in the same tmux command, so a claude that exits at boot leaves its
    # pane, and the reason, readable.
    # 3>&- keeps the launcher's pipe out of the tmux server this may start, which would hold it open.
    if ! tmux new-session -d -s "$SESSION" -c "$CWD" "$RELAUNCH" \; set-option -t "$SESSION" remain-on-exit on 2>>/dev/stderr 3>&-; then
      log "ERROR: could not create detached tmux session $SESSION; nothing delivered"
      _verdict refused "could not create detached tmux session $SESSION, so nothing was started; this session is still the only agent."
      exit 1
    fi
    log "detached session $SESSION created; waiting for claude to take the message"

    if ! _await_prompt "$CONFIG_DIR" "$SUCCESSOR_ID" "$SESSION"; then
      log "ERROR: $WHY_NOT"
      if [[ -s "$GOALFILE" ]]; then
        log "carried goal NOT delivered: /goal $(cat "$GOALFILE")"
      fi
      # The pane is read before the teardown destroys it. Its trailing blank rows are dropped.
      SCREEN=$(tmux capture-pane -p -t "$SESSION" 2>&1) || SCREEN="(the pane could not be read: $SCREEN)"
      SCREEN=$(awk 'NF { last = NR } { row[NR] = $0 } END { for (i = 1; i <= last; i++) print row[i] }' <<<"$SCREEN")
      # A failed wait does not mean nothing started: the message is in the new session's argv, and a late
      # boot would leave two live agents. So the new session is torn down before the verdict is written,
      # and the old process is left running. The `|| true` covers a session that is already gone, which is
      # the state this line is meant to reach.
      tmux kill-session -t "$SESSION" 2>/dev/null || true
      log "detached session $SESSION torn down; the old process remains the only live agent"
      _verdict refused "the successor in detached tmux window '$SESSION' did not take the handoff: $WHY_NOT. Its window is torn down, and this session is still the only agent. Its last screen:" "$SCREEN"
      exit 1
    fi

    log "claude took the message in $SESSION (session $SUCCESSOR_ID)"
    _verdict taken

    # [LAW:no-ambient-temporal-coupling] The old process is retired once the launcher, which runs inside
    # its Bash call, has returned: retiring while the call runs would have claude tear down that call.
    # Waiting on the launcher, not a delay, keeps the overlap to the old session's next model call.
    while _still_captured_process "$LAUNCHER_PID" "$LAUNCHER_IDENT"; do
      sleep 0.2
    done
    # Retirement runs before the optional steps, so a failure there cannot leave the old process running.
    _retire "$OLD_CLAUDE_PID" "$OLD_CLAUDE_IDENT"

    # A successor that later exits normally leaves no dead window behind. Losing this costs a dead window,
    # not a handoff, so it is logged, not fatal.
    tmux set-option -t "$SESSION" remain-on-exit off 2>>/dev/stderr \
      || log "WARNING: could not unset remain-on-exit on $SESSION; its window will linger after claude exits"

    if [[ -s "$GOALFILE" ]]; then
      log "re-establishing carried goal"
      _clear_box "$SESSION"
      { printf '/goal '; cat "$GOALFILE"; } | tmux load-buffer -b "$GOALBUF" -
      tmux paste-buffer -d -b "$GOALBUF" -t "$SESSION" -p
      sleep 0.5
      tmux send-keys -t "$SESSION" Enter
    fi
    ;;

  remote-worker)
    if [[ $# -lt 4 ]]; then
      echo "internal error: remote-worker expects at least 4 args" >&2
      exit 2
    fi
    trap 'rm -f "$4"' EXIT
    # One process makes every post, since the order of the posts, the login, and how far the log has been
    # read are state the steps share (lib/remote_control.py deliver).
    python3 -I "$REMOTE" deliver "$1" "$2" "$3" "$4" "$REMOTE_IDLE_TIMEOUT_SECONDS" \
      "$RESET_REGISTER_TIMEOUT_SECONDS" "${@:5}"
    ;;
esac
