#!/usr/bin/env bash
# finalize-session: schedules a delayed self-handoff into the current session. The launcher returns
# immediately, and a detached worker delivers the handoff after a fixed delay.
#
# Transports, most reliable first:
#   tmux      - clears the pane with /clear, verifies it by reading the pane back, then pastes the message.
#   iTerm2    - kills the running claude and relaunches it with the message as its initial prompt, sent
#               with `write text` to the exact session.
#   detached  - for a session that no pane or iTerm2 session owns, such as one hosted by `claude daemon
#               run`. Starts a new detached tmux window running claude with the message as its initial
#               prompt, and retires the old process once the new one is ready.
#
# Every session can continue an autonomy chain. A launcher that cannot schedule the handoff refuses through
# _refuse (reason on stderr, exit 2); exit 0 means the worker is scheduled, and the worker's own failures go
# to its log.
#
# Modes:
#   launcher:         see --help
#   tmux worker:      finalize-session --worker <target> <msgfile> <goalfile> [<slash-command>...]
#   iTerm2 worker:    finalize-session --iterm-worker <uuid> <claude_pid> <claude_ident> <msgfile> <goalfile> <flags>
#   detached worker:  finalize-session --detached-worker <session> <cwd> <msgfile> <goalfile> <flags> <old_claude_pid> <claude_bin> <old_claude_ident>

set -euo pipefail

# HANDOFF_DELAY_SECONDS is the wait before firing. RESET_REGISTER_* bound the poll that waits for the
# reset to appear in the pane (tmux).
HANDOFF_DELAY_SECONDS=10
# The reset is typed while the agent is usually still mid-turn, and Claude runs queued input only when
# the turn ends. So the worker polls for the reset to appear instead of waiting a fixed time. The timeout
# can be overridden so tests can reach the timeout path.
RESET_REGISTER_TIMEOUT_SECONDS="${MEMENTO_RESET_TIMEOUT_SECONDS:-300}"
RESET_REGISTER_POLL_SECONDS=0.5

# The handoff file is the authoritative copy. Pasted and relaunched copies are derived from it, and they
# can be lost, but the file is not.
HANDOFF_DIR="${MEMENTO_HANDOFF_DIR:-$HOME/.claude/memento/handoffs}"
# How long to wait for a relaunched claude to show its input box before queueing a /goal into it (iTerm2
# only). The worker polls and proceeds as soon as the session is ready, and fails on timeout rather than
# typing into a box that is not ready.
CLAUDE_READY_TIMEOUT_SECONDS=30
CLAUDE_READY_POLL_SECONDS=0.5

# The framing wrapped around the agent's message. The launcher joins PREFIX, the message, and SUFFIX into
# one value, and the workers pass it through unchanged.
HANDOFF_PREFIX=$(cat <<'PREFIX'
=== Below is a message from an agent on behalf of the user ===
PREFIX
)
HANDOFF_SUFFIX=$(cat <<'SUFFIX'
=== The above message was sent on behalf of the user, but as it was sent from an agent, double checking the claims is wise.  When in doubt, note any divergence and run the '/next' skill to proceed.  Do NOT ask the user if you should run '/next'. ===
SUFFIX
)

# Clears the input box before writing to it. Leftover text would fuse with the new input, so C-u is sent
# first. Escape does not clear the box.
_clear_box() {
  tmux send-keys -t "$1" C-u
  sleep 0.3
}

# Prints the process table the ancestry walk reads, one row per process: `pid ppid etime exe`, where exe is
# the executable's name as the kernel records it (ps's ucomm), which ps reads for every owner. exe comes last
# because it may hold spaces. No argv is read: a process is known by its executable, and a session's
# settings come from what Claude Code reports (see _session_report), never from the command line it was
# started with.
_process_table() {
  ps -eo pid=,ppid=,etime=,ucomm=
}

# Decides, from one snapshot of the tmux panes and one of the process table, what this session's ancestry
# lets a handoff reach: _ancestry <pane rows> <_process_table rows>. Pure: it reads only its arguments, $$, and
# $CLAUDE_PID, which the launcher requires before calling it. It prints four lines: the kind, the pane id,
# the own claude's pid, and the reason, which comes last because it is never empty, so the empty fields
# before it survive `$(...)`.
#   pane      a live pane shows this session; the pane id names it.
#   paneless  the walk reached init with no pane and no other claude, so this session owns its terminal.
#   confined  something above this session may show another one: another claude (a daemon host, or an
#             outer session this claude was started inside), a tmux server that lists no pane of this
#             session, or ancestry the walk could not establish.
#             Only a fresh detached window is safe.
#   refused   the walk ended, however, without passing this session's claude; the reason says how it ended.
#
# [LAW:single-enforcer] This is the one walk. The hosted decision and the pane are both read in it, hop by
# hop, under the same rules:
#   - A row that is missing, or whose elapsed time is unreadable or younger than its child's, ends the walk
#     as confined. A parent is never younger than its child, so a younger one holds a reissued pid, and
#     nothing above it is this session's ancestry. The clock has one-second resolution, so a pid reissued
#     within the same second as its child's start can still pass.
#   - The own claude is $CLAUDE_PID, which Claude Code sets for every tool call. It is identified by the
#     walk passing it, not by its executable, so a claude run under node keeps its pane.
#   - Nothing is handed off unless the walk passed the own claude. Any ending reached first is refused:
#     a pane, another claude, or init shows $CLAUDE_PID is outside this process's tree, and an unsound row
#     or the hop bound leaves it unproven, so relaunching it could signal a session that never asked.
#   - Any other claude above the own one ends the walk as confined, whatever it runs, since the tree's
#     shape is what shows hosting. A claude is checked before its pane, since a pane's process is usually
#     the claude it shows. Since the own claude is never inferred, a process mistaken for a claude only
#     ever confines or refuses, so the match is generous.
#   - The walk examines this process and 15 ancestors. At that bound it ends as confined.
# A wrong confinement costs a relaunch, and a wrong pane costs a /clear in someone else's session, so every
# doubt resolves to confined.
_ancestry() {
  printf '%s\n%s\n' "$1" "$2" | awk -v self=$$ -v own="$CLAUDE_PID" -v maxhops=16 '
    # ps renders elapsed time as [[dd-]hh:]mm:ss; fold it left into seconds so
    # any of the three widths compares against any other.
    function ageof(raw,   days, parts, fields, i, seconds) {
      days = 0
      if (raw ~ /-/) {
        days = substr(raw, 1, index(raw, "-") - 1) + 0
        raw = substr(raw, index(raw, "-") + 1)
      }
      fields = split(raw, parts, ":")
      seconds = 0
      for (i = 1; i <= fields; i++) seconds = seconds * 60 + parts[i] + 0
      return days * 86400 + seconds
    }
    # A claude by its executable: `claude`, a packager'\''s wrapped form, or the native installer'\''s binary,
    # which is named for its version (`.../claude/versions/2.1.299`).
    function isclaude(pid) {
      return exe[pid] ~ /^\.?claude(-wrapped)?$/ || exe[pid] ~ /^[0-9]+\.[0-9]+\.[0-9]+$/
    }
    # A tmux by its executable, wrapped forms (`.tmux-wrapped`) and a Linux server retitled
    # `tmux: server` included.
    function istmux(pid) {
      return exe[pid] ~ /tmux/
    }
    # Why the row for pid cannot stand as the parent of a process aged `younger`, or "" when it can.
    function unsound(pid, younger) {
      if (!(pid in parent)) return "process " pid " has no row in the process table"
      if (elapsed[pid] !~ /^([0-9]+-)?([0-9]+:)?[0-9]+:[0-9][0-9]$/)
        return "the elapsed time of process " pid " cannot be read"
      if (ageof(elapsed[pid]) < younger)
        return "process " pid " is younger than its child, so its pid was reissued"
      return ""
    }
    # Every ending passes through here, so the rule a handoff needs is kept once: nothing is handed off
    # unless the walk passed the own claude, whatever ended it.
    function answer(kind, pane, reason) {
      if (!passed) {
        reason = "the ancestry walk never passed $CLAUDE_PID " own ", so nothing it reached is this session'\''s to hand off: " reason
        kind = "refused"; pane = ""
      }
      printf "%s\n%s\n%s\n%s\n", kind, pane, own, reason
      exit 0
    }
    # tmux labels its own rows with a literal "pane", so one pass tells the two snapshots apart. A row
    # counts only if it positively reports the pane alive: tmux renders an unknown format field as empty,
    # so a tmux without #{pane_dead} matches no pane.
    $1 == "pane" { if (NF == 4 && $4 == "0") pane[$3] = $2; next }
    NF >= 4 {
      parent[$1] = $2
      elapsed[$1] = $3
      exe[$1] = $4
      for (i = 5; i <= NF; i++) exe[$1] = exe[$1] " " $i
    }
    END {
      passed = 0
      pid = self
      younger = -1
      for (hop = 0; hop < maxhops; hop++) {
        why = unsound(pid, younger)
        if (why != "") answer("confined", "", why)
        # Compared as strings: awk compares two numeric-looking strings as numbers, so `0300` would
        # match pid 300.
        if (pid "" == own "") passed = 1
        # Above the own claude, another claude hosts this session; below it, $CLAUDE_PID was never passed.
        else if (isclaude(pid))
          answer("confined", "", passed ? "hosted by another claude (process " pid ")" : "it met claude process " pid " first")
        if (pid in pane) answer("pane", pane[pid], "process " pid " is the process of pane " pane[pid])
        # A pane process sits directly below its tmux server, so reaching the server means tmux listed
        # no live pane of this session: whatever terminal shows it, that terminal does not belong to this session.
        if (istmux(pid)) answer("confined", "", "tmux process " pid " is above this session, but tmux lists no live pane of it")
        younger = ageof(elapsed[pid])
        pid = parent[pid]
        if (pid + 0 <= 1) break
      }
      if (hop == maxhops) answer("confined", "", "the walk ended at its " maxhops "-hop bound without a pane")
      answer("paneless", "", "the walk reached init without a pane")
    }'
}

# Sets CLAUDE_PID, CLAUDE_IDENT and FLAGS for relaunching the own claude, or refuses in the named
# transport's voice. Only an interactive session is relaunched: relaunching a headless one would sever its
# client. Claude Code says which it is in $CLAUDE_CODE_ENTRYPOINT, `cli` for an interactive session.
#
# The identity is captured at the same instant as the pid and passed on as data. The worker compares against
# it before signaling, since by then the pid may belong to another process. A pid that cannot be identified
# is never signaled, so this is a hard stop.
_relaunch_target() { # <transport name> <own claude pid>
  CLAUDE_PID=$2
  [[ "${CLAUDE_CODE_ENTRYPOINT:-}" == cli ]] \
    || _refuse "$1: claude process $CLAUDE_PID is not an interactive session (\$CLAUDE_CODE_ENTRYPOINT is '${CLAUDE_CODE_ENTRYPOINT:-}', not 'cli'), so it cannot be relaunched"
  _session_report "$1"
  _relaunch_flags
  CLAUDE_IDENT=$(_process_identity "$CLAUDE_PID") \
    || _refuse "$1: cannot read the identity of claude process $CLAUDE_PID"
}

# Reads what memento's PreToolUse hook reported about this session just before this command ran: the
# permission mode it is in and its effort level, one per line. Sets REPORTED_MODE and REPORTED_EFFORT, or
# refuses. [LAW:one-source-of-truth] Claude Code hands the hook these live values, so a mode switched
# mid-session carries over; the old process's argv is never read for them.
#
# The report is consumed: it is removed before anything is started, so no later run can act on it. It
# lives under $HOME, not $TMPDIR: Claude Code's sandbox gives a Bash call its own $TMPDIR, which the hook
# never sees.
_session_report() { # <transport name>
  local report mode effort
  [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] \
    || _refuse "$1: \$CLAUDE_CODE_SESSION_ID is unset, so this session's report cannot be found"
  report="$HOME/.claude/memento/reports/$CLAUDE_CODE_SESSION_ID"
  [[ -f "$report" ]] \
    || _refuse "$1: no report of this session's permission mode at $report; memento's PreToolUse hook writes it before a Bash call that runs finalize-session"
  { IFS= read -r mode || true; IFS= read -r effort || true; } < "$report"
  rm -- "$report" || _refuse "$1: cannot remove the consumed report $report"
  # [LAW:parse-dont-validate] The modes Claude Code reports; anything else is not a mode to relaunch in.
  case "$mode" in
    default|plan|acceptEdits|auto|dontAsk|bypassPermissions) ;;
    *) _refuse "$1: the report at $report names no permission mode Claude Code reports ('$mode')" ;;
  esac
  case "$effort" in
    *[!A-Za-z0-9_-]*) _refuse "$1: the report at $report names an effort that is not one word ('$effort')" ;;
  esac
  REPORTED_MODE=$mode
  REPORTED_EFFORT=$effort
}

# Returns what a pid holds, as its start time and command line. Those survive the pid being reissued.
# Empty output means the pid holds nothing, and that is a failure to identify.
#
# A pid alone does not identify a process, since the kernel can reissue it after its holder exits. Start
# time tells the two apart. The detached worker signals a pid up to about 41 seconds after capturing it, so
# this check is as strict as the ancestry walk's pid-reuse guard.
_process_identity() {
  local pid="${1:-}" raw
  [ -n "$pid" ] || return 1
  raw=$(ps -o lstart=,command= -p "$pid" 2>/dev/null) || return 1
  [ -n "$raw" ] || return 1
  printf '%s' "$raw"
}

# Answers whether a pid still holds the process captured at launch. `kill -0` is not enough, since it
# only shows that some process is alive at the pid. Every check in the retirement sequence (the gate, the
# poll, and the KILL escalation) uses this, because TERM frees the pid for reuse during the poll.
#
# The reading is left in IDENT_NOW, so the caller reports the value its check used.
_still_captured_process() { # <pid> <identity captured at launch>
  IDENT_NOW=$(_process_identity "$1") || IDENT_NOW=""
  [[ "$IDENT_NOW" == "$2" ]]
}

# Retires the claude captured at launch, TERM first and KILL if it lingers. Both relaunching workers use
# this, so neither signals a pid that no longer holds the captured process. Reports through the worker's log.
_retire() { # <pid> <identity captured at launch>
  if _still_captured_process "$1" "$2"; then
    kill -TERM "$1" 2>/dev/null || true
    # The poll stops when the captured process has exited or the pid holds another process.
    for _ in $(seq 1 20); do
      _still_captured_process "$1" "$2" || break
      sleep 0.5
    done
    if _still_captured_process "$1" "$2"; then
      log "old claude $1 survived TERM; sending KILL"
      kill -KILL "$1" 2>/dev/null || true
    fi
    log "old claude $1 terminated"
  else
    log "old claude $1 is gone: pid now holds [${IDENT_NOW:-nothing}], not the process captured at launch [$2]. Nothing to retire."
  fi
}

# The command line every relaunch runs: claude, the kept flags, and the handoff read from its file. Each
# piece is shell-quoted, so a path containing a quote cannot break the line.
_relaunch_line() {
  local bin msg
  printf -v bin '%q' "$1"
  printf -v msg '%q' "$MSGFILE"
  printf '%s' "$bin ${FLAGS:+$FLAGS }\"\$(cat $msg)\""
}

# Prints the visible contents of the iTerm2 session with the given UUID, the analog of tmux's
# `capture-pane -p`. The readiness probe polls it for the relaunched claude's banner before a /goal is
# queued. The old claude's alternate screen is torn down on exit, so a banner match can only come from the relaunch.
_iterm_session_contents() {
  local uuid="$1"
  # osascript errors go to the worker log. A healthy read writes nothing to stderr.
  osascript <<OSA 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${uuid}" then
          return contents of s
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA
}

# Refuses the run with a reason: _refuse <reason>. Exits 2, and names the handoff's path if one was recorded.
# RECORDED is empty until the handoff is written, and is always interpolated, so the message is correct on
# either side of the write.
_refuse() {
  echo "finalize-session: $1${RECORDED:+
The handoff was NOT delivered. It is preserved at: $RECORDED}" >&2
  exit 2
}

# Makes a temp file or refuses: _mktemp_or_exit <varname> <purpose>. The result is assigned through the
# caller's variable, so the exit belongs to this script. `mktemp -t` ignores $TMPDIR on macOS, so the
# refusal names the purpose and no directory.
_mktemp_or_exit() {
  local __var="$1" purpose="$2" path
  path=$(mktemp -t "finalize-$purpose.XXXXXX") \
    || _refuse "cannot create the $purpose tempfile."
  printf -v "$__var" '%s' "$path"
}

# Sets FLAGS, what the relaunched claude starts with: the reported permission mode, the requested model, and
# the requested effort, else the reported one. A model is carried only when requested, since nothing
# reports the one a session runs honestly. Each value is shell-quoted, since a shell parses the relaunch
# line: unquoted, `--model opus[1m]` is a zsh glob that matches nothing, which aborts the line.
_relaunch_flags() {
  local effort="${EFFORT:-$REPORTED_EFFORT}"
  printf -v FLAGS '%q %q' --permission-mode "$REPORTED_MODE"
  [[ -z "$MODEL" ]] || FLAGS+=" $(printf '%q %q' --model "$MODEL")"
  [[ -z "$effort" ]] || FLAGS+=" $(printf '%q %q' --effort "$effort")"
}

# Refuses a --model/--effort value that cannot be one word: _setting_value <flag> <value>. The value is typed into
# a slash command or appended to a relaunch line, so a missing argument that swallowed the next flag, or a value
# with whitespace, would become a different command.
_setting_value() {
  case "$2" in
    ''|-*|*[[:space:]]*)
      echo "$1 requires a single-word value, got '$2'" >&2
      exit 2 ;;
  esac
}

# The usage text. The header's Modes block refers to it.
_usage() {
  cat <<'USAGE'
finalize-session — record the session handoff and reset the session into it.

usage: finalize-session [--goal <condition>] [--model <model>] [--effort <level>]
                        [--] [message...]

  --goal <condition>      re-issue an active /goal into the reset session, which
                          otherwise wakes with no goal and stops an unattended run
  --model <model>         start the next session on this model; omit to leave the
                          model as the transport leaves it
  --effort <level>        start the next session at this effort level; omit to
                          leave it as the transport leaves it
  --                      end flag parsing; every token after it is message text
  message...              what the next agent wakes up holding (default: /next)

  FINALIZE_DRY_RUN=1      report the transport it would use; schedule nothing
  MEMENTO_HANDOFF_DIR     where the handoff is written
                          (default: ~/.claude/memento/handoffs)

Every flag here has two dashes, so only a two-dash word is read as one. Anything
else is message: -h, "- shipped the parser", any argument carrying a newline.

exit: 0 it did what you asked · 2 it could not — argv, setup, or transport
USAGE
}

# Selects the mode once, from the first argument.
case "${1:-}" in
  --worker)          MODE=tmux-worker; shift ;;
  --iterm-worker)    MODE=iterm-worker; shift ;;
  --detached-worker) MODE=detached-worker; shift ;;
  *)                 MODE=launcher ;;
esac

case "$MODE" in

  launcher)
    # A leading --goal <condition> is stripped here, so the rest is the message. /clear and a fresh relaunch
    # both drop the session's /goal, so it is re-issued into the new session. An absent goal is an empty string.
    GOAL=""
    # --model and --effort are set only when the caller asks. Empty means the transport's own behavior stands.
    MODEL=""
    EFFORT=""
    # A literal newline, for matching inside a case pattern below.
    NEWLINE=$'\n'
    while :; do
      case "${1:-}" in
        --goal)
          GOAL="${2:-}"
          shift 2 || { echo "--goal requires a condition argument" >&2; exit 2; }
          ;;
        --model)
          _setting_value --model "${2:-}"; MODEL="$2"
          shift 2 ;;
        --effort)
          _setting_value --effort "${2:-}"; EFFORT="$2"
          shift 2 ;;
        --help)
          _usage; exit 0 ;;
        # `--` ends flag parsing, so a handoff that must start with `--` can still be sent.
        --)
          shift; break ;;
        # A token containing a newline is message text, since no flag spans a line.
        --*"$NEWLINE"*)
          break ;;
        # Only two-dash words are flags. An unknown one is refused rather than sent as the handoff, so a typo
        # such as `--rest compact` is not delivered as text. A single-dash token such as `-h` is message text.
        --*)
          echo "unknown flag '$1' — finalize-session --help lists what it takes." >&2
          echo "To send it as handoff text, put it after --." >&2
          exit 2 ;;
        *) break ;;
      esac
    done

    # The message defaults to /next when no arguments are given.
    AGENT_MESSAGE="${*:-/next}"

    # The message is passed between processes as a file, so no shell quoting is involved. The file is kept
    # after delivery, since it is the handoff itself.

    # Empty until the handoff is on disk. Every refusal below reads it.
    RECORDED=""
    # _refuse is the exit for every give-up. The ERR trap routes an unexpected failing command into _refuse.
    # The trap fires only on a failing command, so an assignment that swallows its own failure is checked by
    # hand (see SELFDIR below). Condition contexts such as `a || b` and `if` are exempt, so the transport
    # probes below can fall through.
    trap '_refuse "unexpected failure at line $LINENO: $BASH_COMMAND"' ERR
    mkdir -p -- "$HANDOFF_DIR" \
      || _refuse "cannot create handoff directory $HANDOFF_DIR"
    MSGFILE="$HANDOFF_DIR/$(date -u '+%Y%m%dT%H%M%SZ')-$$.md"

    # The wrapped message is built once and includes the handoff file's path, so every copy points to the
    # full text on disk.
    MESSAGE=$(printf '%s\n%s\n%s\n\nThis handoff verbatim on disk: %s' \
      "$HANDOFF_PREFIX" "$AGENT_MESSAGE" "$HANDOFF_SUFFIX" "$MSGFILE")

    _mktemp_or_exit GOALFILE goal
    LOGFILE=""
    # The EXIT trap removes transient files only. The handoff file is kept.
    trap 'rm -f -- "$GOALFILE" ${LOGFILE:+"$LOGFILE"}' EXIT
    # $RECORDED stays empty until the write succeeds, so a half-written file is never reported as the handoff.
    printf '%s' "$MESSAGE" > "$MSGFILE" \
      || _refuse "cannot write the handoff to $MSGFILE"
    RECORDED="$MSGFILE"
    # The goal is passed as a file value, empty when none was carried. Workers re-issue /goal only when it is non-empty.
    printf '%s' "$GOAL" > "$GOALFILE" \
      || _refuse "cannot write the carried goal to $GOALFILE"

    # The tmux transport types these into the reset session before the handoff prompt, so the handoff's first turn
    # already runs on them. The relaunching transports pass them as claude flags instead. Empty when neither was
    # requested.
    SETTING_COMMANDS=()
    [[ -n "$MODEL" ]] && SETTING_COMMANDS+=("/model $MODEL")
    [[ -n "$EFFORT" ]] && SETTING_COMMANDS+=("/effort $EFFORT")

    # A handoff always resets the session. The next session starts blank and holds only the message.

    # Resolve own path for both ./script and PATH-lookup invocations.
    if [[ "$0" == */* ]]; then
      SELF_RAW="$0"
    else
      SELF_RAW=$(command -v -- "$0") \
        || _refuse "cannot resolve own path from \$0=$0"
    fi
    # Split into two assignments: in one assignment only the last command's status counts, so a failed `cd`
    # would go unnoticed and leave SELF malformed.
    SELFDIR=$(cd "$(dirname "$SELF_RAW")" && pwd) \
      || _refuse "cannot resolve own directory from \$0=$0"
    SELF="$SELFDIR/$(basename "$SELF_RAW")"

    # Transport detection runs once, here. Each worker receives the result as a typed value and does not
    # re-detect.
    #
    # [LAW:effects-at-boundaries] The process table and the panes are each read once, here, and _ancestry
    # decides every transport question from those two readings. No tmux binary, or no server, means no
    # panes. The environment's $TMUX_PANE is never read: it is inherited, so a daemon passes its spawner's
    # down, and a pane the walk did not reach is not this session's whatever the environment says.
    # Claude Code sets $CLAUDE_PID for every tool call, so without it this is not a session's tool call,
    # and no process is known to be the one to hand off.
    [[ -n "${CLAUDE_PID:-}" ]] \
      || _refuse "\$CLAUDE_PID is unset, so no process is known to be this session's claude"
    PROCS=$(_process_table) \
      || _refuse "cannot read the process table, so no transport can be shown to be this session's"
    PANES=$(tmux list-panes -a -F 'pane #{pane_id} #{pane_pid} #{pane_dead}' 2>/dev/null) || PANES=""
    # Captured before it is read, since a substitution inside a redirection escapes the ERR trap.
    WALK=$(_ancestry "$PANES" "$PROCS")
    { IFS= read -r KIND; IFS= read -r PANE; IFS= read -r OWN_PID; IFS= read -r REASON; } \
      <<<"$WALK"
    [[ -z "${FINALIZE_DRY_RUN:-}" ]] || echo "[dry-run] ancestry: $KIND, $REASON"
    [[ "$KIND" != refused ]] || _refuse "$REASON"
    # The pane id is the target: tmux keeps it for the pane's life, where a session:window.pane index can
    # shift before the worker wakes.
    if [[ "$KIND" == pane ]]; then
      TARGET="$PANE"
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=tmux target=$TARGET msgfile=$MSGFILE"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        echo "[dry-run] requested model: ${MODEL:-(none)} effort: ${EFFORT:-(none)}"
        exit 0
      fi
      _mktemp_or_exit LOGFILE log
      nohup "$SELF" --worker "$TARGET" "$MSGFILE" "$GOALFILE" ${SETTING_COMMANDS[@]+"${SETTING_COMMANDS[@]}"} \
        </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → tmux $TARGET in ${HANDOFF_DELAY_SECONDS}s (log: $LOGFILE)"

    # $ITERM_SESSION_ID is inherited like $TMUX_PANE, so it names this session's terminal only when the walk
    # showed nothing above this session that could own it.
    elif [[ "$KIND" == paneless && "${TERM_PROGRAM:-}" == "iTerm.app" && -n "${ITERM_SESSION_ID:-}" ]] \
         && osascript -e 'tell application "iTerm2" to get version' >/dev/null 2>&1; then
      UUID="${ITERM_SESSION_ID#*:}"
      _relaunch_target "iTerm2 transport" "$OWN_PID"
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=iTerm2 uuid=$UUID claude_pid=$CLAUDE_PID flags=[$FLAGS]"
        echo "[dry-run] would relaunch: $(_relaunch_line claude)"
        echo "[dry-run] old-process identity: $CLAUDE_IDENT"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        exit 0
      fi
      _mktemp_or_exit LOGFILE log
      nohup "$SELF" --iterm-worker "$UUID" "$CLAUDE_PID" "$CLAUDE_IDENT" "$MSGFILE" "$GOALFILE" "$FLAGS" \
        </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → iTerm2 (kill+relaunch, fresh) in ${HANDOFF_DELAY_SECONDS}s (log: $LOGFILE)"

    elif command -v tmux >/dev/null 2>&1; then
      # No owned pane and no reachable iTerm2 session, as with a session hosted by `claude daemon run`.
      # `new-session -d` starts a tmux server if none is running. The relaunch process is the walk's own
      # claude, as for the iTerm2 transport.
      _relaunch_target "detached transport" "$OWN_PID"
      # A fresh detached window starts a login shell that may rebuild PATH, so the absolute path is resolved
      # here and passed down as data. An unresolvable `claude` is a refusal, not a fallback to a bare name.
      CLAUDE_BIN=$(command -v claude) \
        || _refuse "detached transport: 'claude' is not resolvable on PATH; cannot name what to relaunch"
      CWD=$(pwd -P)
      # tmux session names cannot contain ':' or '.'. The pid and epoch seconds are digits only.
      SESSION="finalize-$$-$(date +%s)"
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=detached session=$SESSION cwd=$CWD claude_pid=$CLAUDE_PID claude_bin=$CLAUDE_BIN flags=[$FLAGS]"
        echo "[dry-run] would launch: $(_relaunch_line "$CLAUDE_BIN") in a fresh detached tmux window"
        echo "[dry-run] old-process identity: $CLAUDE_IDENT"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        exit 0
      fi
      _mktemp_or_exit LOGFILE log
      nohup "$SELF" --detached-worker "$SESSION" "$CWD" "$MSGFILE" "$GOALFILE" "$FLAGS" "$CLAUDE_PID" "$CLAUDE_BIN" "$CLAUDE_IDENT" \
        </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → fresh detached tmux window '$SESSION' in ${HANDOFF_DELAY_SECONDS}s (log: $LOGFILE)"

    else
      # Nothing can deliver the handoff: no owned pane, no reachable iTerm2 session, and no tmux binary. The
      # handoff is already on disk, so the refusal names its path. The nonzero exit tells the caller the
      # close-out did not happen. The walk's reason says why no pane or iTerm2 session could be used.
      _refuse "no owned tmux pane and no reachable iTerm2 session ($REASON), and no tmux binary to start a detached window with.
Nothing on this machine to deliver the close-out into."
      # GOALFILE cleaned by the EXIT trap; MSGFILE deliberately kept.
    fi
    ;;

  tmux-worker)
    if [[ $# -lt 3 ]]; then
      echo "internal error: worker expects at least 3 args" >&2
      exit 2
    fi
    TARGET="$1"
    MSGFILE="$2"
    GOALFILE="$3"
    shift 3

    BUFFER="finalize-$$"
    GOALBUF="finalize-goal-$$"
    trap 'rm -f "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    # The banner a fresh session prints; seeing it is what confirms /clear landed.
    REGISTERED_RE='Claude Code v[0-9]'

    log "waking; target=$TARGET"
    sleep "$HANDOFF_DELAY_SECONDS"

    tmux send-keys -t "$TARGET" Escape
    sleep 1
    _clear_box "$TARGET"
    tmux send-keys -t "$TARGET" "/clear"
    sleep 0.5
    tmux send-keys -t "$TARGET" Enter

    # Polls for the reset to appear, up to the timeout. The poll count is integer arithmetic, since bash 3.2
    # (the /bin/bash on macOS) has no floats.
    POLL_BUDGET=$(awk "BEGIN{printf \"%d\", $RESET_REGISTER_TIMEOUT_SECONDS / $RESET_REGISTER_POLL_SECONDS}")
    POLLS=0
    OBSERVED="WARNING: not observed within ${RESET_REGISTER_TIMEOUT_SECONDS}s"
    while :; do
      if tmux capture-pane -t "$TARGET" -p | grep -qE "$REGISTERED_RE"; then
        OBSERVED="registered after $(awk "BEGIN{printf \"%.1f\", $POLLS * $RESET_REGISTER_POLL_SECONDS}")s"
        break
      fi
      [[ "$POLLS" -ge "$POLL_BUDGET" ]] && break
      sleep "$RESET_REGISTER_POLL_SECONDS"
      POLLS=$((POLLS + 1))
    done

    # The handoff is sent whether or not the reset was seen; the poll result only goes into the log. tmux
    # type-ahead keeps input in order, so the handoff lands after the queued reset either way.
    log "/clear $OBSERVED; sending handoff (preserved at $MSGFILE)"

    # The requested /model and /effort go in before the handoff, while the reset session's box is idle, so the
    # handoff's first turn already runs on them. Each value is a single word, so typing it literally is safe.
    for SETTING in "$@"; do
      log "setting $SETTING"
      _clear_box "$TARGET"
      tmux send-keys -t "$TARGET" -l "$SETTING"
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter
      sleep 1
    done

    _clear_box "$TARGET"
    tmux load-buffer -b "$BUFFER" "$MSGFILE"
    tmux paste-buffer -d -b "$BUFFER" -t "$TARGET" -p
    sleep 0.5
    tmux send-keys -t "$TARGET" Enter

    # The goal is queued after the handoff prompt, so it does not race the handoff turn. /clear wiped it.
    if [[ -s "$GOALFILE" ]]; then
      log "re-establishing carried goal"
      sleep 1
      _clear_box "$TARGET"
      { printf '/goal '; cat "$GOALFILE"; } | tmux load-buffer -b "$GOALBUF" -
      tmux paste-buffer -d -b "$GOALBUF" -t "$TARGET" -p
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter
    fi
    ;;

  iterm-worker)
    if [[ $# -lt 5 ]]; then
      echo "internal error: iterm-worker expects at least 5 args" >&2
      exit 2
    fi
    UUID="$1"
    CLAUDE_PID="$2"
    CLAUDE_IDENT="$3"
    MSGFILE="$4"
    GOALFILE="$5"
    FLAGS="${6:-}"

    trap 'rm -f "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    log "waking; iterm uuid=$UUID claude_pid=$CLAUDE_PID flags=[$FLAGS]"
    sleep "$HANDOFF_DELAY_SECONDS"

    # Stop the running claude so the shell regains the session.
    _retire "$CLAUDE_PID" "$CLAUDE_IDENT"

    # Let the shell draw its prompt before typing into it.
    sleep 2

    # The shell reads the message from MSGFILE, so no message text enters argv or AppleScript. Only \ and "
    # are escaped for AppleScript.
    RELAUNCH=$(_relaunch_line claude)
    AS=${RELAUNCH//\\/\\\\}
    AS=${AS//\"/\\\"}

    if osascript <<OSA 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${UUID}" then
          write s text "${AS}"
          return
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA
    then
      log "relaunch command sent to iTerm2 session $UUID"
      # Re-queues the carried goal, which the relaunch wiped. It is sent only when the goal file is non-empty.
      if [[ -s "$GOALFILE" ]]; then
        # Polls until the relaunched claude shows its banner, then proceeds. On timeout the goal is logged as
        # not delivered, never as re-established. 'Claude Code v[0-9]' is the fresh-boot banner.
        log "waiting for relaunched claude to become ready (up to ${CLAUDE_READY_TIMEOUT_SECONDS}s)"
        READY=""
        DEADLINE=$(( $(date +%s) + CLAUDE_READY_TIMEOUT_SECONDS ))
        while [[ $(date +%s) -le $DEADLINE ]]; do
          # Captures the output first and greps a herestring. Piping osascript into `grep -q` can SIGPIPE
          # osascript, and under pipefail that reports a match as a failure.
          SNAP=$(_iterm_session_contents "$UUID")
          if grep -qE 'Claude Code v[0-9]' <<<"$SNAP"; then
            READY=1
            break
          fi
          sleep "$CLAUDE_READY_POLL_SECONDS"
        done

        if [[ -z "$READY" ]]; then
          log "ERROR: relaunched claude in session $UUID did not become ready within ${CLAUDE_READY_TIMEOUT_SECONDS}s; carried goal NOT delivered. Deliver it manually once the session is up: /goal $(cat "$GOALFILE")"
        else
          # Waits a second for the input box to settle, then queues the goal.
          sleep 1
          log "claude ready; re-establishing carried goal"
          GOALCMD="/goal $(cat "$GOALFILE")"
          GAS=${GOALCMD//\\/\\\\}
          GAS=${GAS//\"/\\\"}
          if osascript <<OSA2 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${UUID}" then
          write s text "${GAS}"
          return
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA2
          then
            log "carried goal re-established in iTerm2 session $UUID"
          else
            log "ERROR: could not re-establish carried goal in session $UUID"
          fi
        fi
      fi
    else
      log "ERROR: could not write relaunch to iTerm2 session $UUID"
    fi

    # Give the shell time to read the message file before this worker exits.
    sleep 3
    ;;

  detached-worker)
    if [[ $# -ne 8 ]]; then
      echo "internal error: detached-worker expects exactly 8 args" >&2
      exit 2
    fi
    SESSION="$1"
    CWD="$2"
    MSGFILE="$3"
    GOALFILE="$4"
    FLAGS="$5"
    OLD_CLAUDE_PID="$6"
    CLAUDE_BIN="$7"
    OLD_CLAUDE_IDENT="$8"

    GOALBUF="finalize-goal-$$"
    trap 'rm -f "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    log "waking; detached session=$SESSION cwd=$CWD old_claude_pid=$OLD_CLAUDE_PID claude_bin=$CLAUDE_BIN flags=[$FLAGS]"
    sleep "$HANDOFF_DELAY_SECONDS"

    # The new window's shell reads the message from the file, so the message never reaches argv or tmux quoting.
    # Only the paths and flags are escaped, by _relaunch_line. CLAUDE_BIN is the absolute path resolved by the launcher.
    RELAUNCH=$(_relaunch_line "$CLAUDE_BIN")
    if ! tmux new-session -d -s "$SESSION" -c "$CWD" "$RELAUNCH" 2>>/dev/stderr; then
      log "ERROR: could not create detached tmux session $SESSION; nothing delivered"
      exit 1
    fi
    log "detached session $SESSION created; waiting for claude to become ready"

    # Polls for the fresh boot's banner, as the iTerm2 worker does, so the goal is never queued before the input box is up.
    READY=""
    DEADLINE=$(( $(date +%s) + CLAUDE_READY_TIMEOUT_SECONDS ))
    while [[ $(date +%s) -le $DEADLINE ]]; do
      if tmux has-session -t "$SESSION" 2>/dev/null \
         && tmux capture-pane -t "$SESSION" -p 2>/dev/null | grep -qE 'Claude Code v[0-9]'; then
        READY=1
        break
      fi
      sleep "$CLAUDE_READY_POLL_SECONDS"
    done

    if [[ -z "$READY" ]]; then
      log "ERROR: detached session $SESSION did not become ready within ${CLAUDE_READY_TIMEOUT_SECONDS}s"
      if [[ -s "$GOALFILE" ]]; then
        log "carried goal NOT delivered: /goal $(cat "$GOALFILE")"
      fi
      # A timeout does not mean nothing started: the message is already in the new session's argv, and a late
      # boot would leave two live agents. So the new session is torn down, and the old process is left running.
      # The `|| true` covers a session that is already gone, which is the state this line is meant to reach.
      tmux kill-session -t "$SESSION" 2>/dev/null || true
      log "detached session $SESSION torn down; the old process remains the only live agent"
      exit 1
    fi

    log "claude ready in $SESSION"

    # The successor is up and has the message, so the old process is retired now, TERM first and KILL if it
    # lingers. Retirement runs before the optional goal delivery, so a failure there cannot leave the old
    # process running.
    _retire "$OLD_CLAUDE_PID" "$OLD_CLAUDE_IDENT"

    if [[ -s "$GOALFILE" ]]; then
      sleep 1
      log "re-establishing carried goal"
      _clear_box "$SESSION"
      { printf '/goal '; cat "$GOALFILE"; } | tmux load-buffer -b "$GOALBUF" -
      tmux paste-buffer -d -b "$GOALBUF" -t "$SESSION" -p
      sleep 0.5
      tmux send-keys -t "$SESSION" Enter
    fi
    ;;
esac
