#!/usr/bin/env python3
"""Command-line entry point over the address-pr-reviews provider library.

Each subcommand prints its JSON result to stdout. Errors go to stderr with a nonzero exit. A PR
argument is a full URL or a bare number, resolved against the current directory's repo.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# Resolved through symlinks, so sibling modules import the same from any invocation path.
SKILL_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SKILL_DIR))

import findings  # noqa: E402
import github_threads  # noqa: E402
import provider_loader  # noqa: E402
from ports import Ports, production_ports  # noqa: E402


# ---------------------------------------------------------------------------
# Input parsing
# ---------------------------------------------------------------------------

def pr_url(github: github_threads.GitHub, ref: str) -> str:
    """Returns a PR URL for a full URL or a bare number. Raises ValueError for a malformed URL.
    """
    if ref.isdigit():
        url = github.gh("pr", "view", ref, "--json", "url", "--jq", ".url")
        if not url:
            raise RuntimeError(
                f"gh pr view {ref} returned no URL — does PR #{ref} exist in "
                "the current directory's repo?"
            )
        return url
    github_threads.parse_pr(ref)  # raises ValueError on a malformed URL
    return ref


def repo_slug(github: github_threads.GitHub, owner: str | None, repo: str | None) -> tuple[str, str]:
    """Returns (owner, repo): the explicit pair, or the current directory's GitHub remote."""
    if owner is not None and repo is not None:
        return owner, repo
    data = json.loads(github.gh("repo", "view", "--json", "owner,name"))
    return data["owner"]["login"], data["name"]


# ---------------------------------------------------------------------------
# Handlers take the provider and the GitHub client main built, and return (payload, failure_message
# or None). main prints the payload and reports the failure.
# ---------------------------------------------------------------------------

def cmd_caps(provider, github, args) -> tuple[dict, str | None]:
    return provider.CAPABILITIES, None


def cmd_setup_check(provider, github, args) -> tuple[dict, str | None]:
    owner, repo = repo_slug(github, args.owner, args.repo)
    check = provider.setup_check(owner, repo)
    failure = None if check["installed"] else f"Reviewer not installed: {check['message']}"
    return check, failure


def cmd_wait(provider, github, args) -> tuple[dict, str | None]:
    result = provider.wait(pr_url(github, args.pr))
    # [LAW:single-enforcer] the review fetch would refuse is the review wait reports as failed.
    try:
        findings.reviewed_sha(result)
    except ValueError as e:
        return result, str(e)
    return result, None


def cmd_fetch(provider, github, args) -> tuple[dict, str | None]:
    review = json.loads(args.review)
    findings.reviewed_sha(review)  # refused before pr_url's gh call for a bare PR number
    return findings.fetch(provider, pr_url(github, args.pr), review), None


def cmd_change_requests(provider, github, args) -> tuple[dict, str | None]:
    return provider.change_requests(pr_url(github, args.pr)), None


def cmd_resolve(provider, github, args) -> tuple[dict, str | None]:
    return provider.resolve(args.thread_id), None


def cmd_reply(provider, github, args) -> tuple[dict, str | None]:
    return github.reply(args.thread_id, args.body), None


def cmd_dismiss(provider, github, args) -> tuple[dict, str | None]:
    return provider.dismiss_review(pr_url(github, args.pr), args.review_id, args.message), None


def cmd_trigger(provider, github, args) -> tuple[dict, str | None]:
    return provider.trigger(pr_url(github, args.pr)), None


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="review",
        description="CLI over the address-pr-reviews provider library.",
    )
    parser.add_argument(
        "--provider",
        help="pin a provider for this invocation (default: provider.json / "
             "PR_REVIEW_PROVIDER)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # Each subcommand declares the capability it needs, and main() gates on it. Ungated commands carry None.
    def add(name, func, capability=None, help=None):
        p = sub.add_parser(name, help=help)
        p.set_defaults(func=func, capability=capability)
        return p

    add("caps", cmd_caps, help="print the active provider's CAPABILITIES")

    p = add("setup-check", cmd_setup_check, capability="setup_check",
            help="verify the reviewer is installed; nonzero exit when not")
    p.add_argument("owner", nargs="?", default=None)
    p.add_argument("repo", nargs="?", default=None)

    p = add("wait", cmd_wait,
            help="block until the head SHA's review completes; nonzero exit "
                 "unless conclusion is success")
    p.add_argument("pr", help="PR URL or number")

    p = add("fetch", cmd_fetch,
            help="canonical findings JSON, each placed against the head, and whether the loop is done")
    p.add_argument("pr", help="PR URL or number")
    p.add_argument("--review", required=True, metavar="JSON",
                   help="the JSON wait printed, whole: the completed review step 1 waited for")

    p = add("change-requests", cmd_change_requests, capability="dismiss_review",
            help="the automated reviewer's blocking CHANGES_REQUESTED reviews")
    p.add_argument("pr", help="PR URL or number")

    p = add("resolve", cmd_resolve, capability="resolve",
            help="resolve one review thread (verified)")
    p.add_argument("thread_id")

    p = add("reply", cmd_reply, capability="resolve",
            help="post a reply comment on a review thread")
    p.add_argument("thread_id")
    p.add_argument("--body", required=True)

    p = add("dismiss", cmd_dismiss, capability="dismiss_review",
            help="dismiss one stale CHANGES_REQUESTED review (verified)")
    p.add_argument("pr", help="PR URL or number")
    p.add_argument("review_id", type=int)
    p.add_argument("--message", required=True)

    p = add("trigger", cmd_trigger, capability="trigger",
            help="explicitly request a review")
    p.add_argument("pr", help="PR URL or number")

    return parser


def main(ports: Ports) -> int:
    args = build_parser().parse_args()

    # setup-check's owner/repo pair arrives whole or not at all.
    if args.command == "setup-check" and (args.owner is None) != (args.repo is None):
        print("ERROR (setup-check): give both OWNER and REPO, or neither "
              "(inferred from the cwd's GitHub remote).", file=sys.stderr)
        return 2

    try:
        name = provider_loader.resolve_name(args.provider)
        provider = provider_loader.get(name, ports)
        # Capability gate for every subcommand.
        if args.capability and not provider.CAPABILITIES.get(args.capability):
            raise RuntimeError(
                f"provider '{name}' does not support "
                f"'{args.command}': CAPABILITIES[{args.capability!r}] is False."
            )
        payload, failure = args.func(provider, ports.github, args)
    except (RuntimeError, ValueError, NotImplementedError, KeyError) as e:
        print(f"ERROR ({args.command}): {e}", file=sys.stderr)
        return 1

    print(json.dumps(payload, indent=2))
    if failure:
        print(f"ERROR ({args.command}): {failure}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(production_ports()))
