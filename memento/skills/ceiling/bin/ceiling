#!/usr/bin/env python3
"""Move the context ceiling: write the config layers one scope names, and report what is in force.

The grammar of a written ceiling and the order the layers fold in are not here - they are in
`lib/ceiling_config.py`, which the Stop hook reads the same layers through. A writer with its own
copy of that grammar is the divergence [LAW:one-source-of-truth] forbids, and the shape it takes
is specific: a value the hook's reader rejects stops the hook, which Claude Code treats as
non-blocking, so the gate silently stops running for the session whose file holds it. Everything
this writes goes out through that module, which renders what that reader accepts and reads each
file back, so the bad write is unrepresentable rather than merely unlikely.

A scope is data, not a branch: it names the ceiling a move starts from, the files that receive it
and the files a clear takes away, and every command runs the same steps over whatever that data
says. [LAW:dataflow-not-control-flow]

Exit codes, which are a contract: 0 the files now say what this printed; 1 the ceiling asked for
cannot be written or cannot be read back - a config file or a resolved ceiling that is not usable,
the filesystem refusing a read or a write, or the session or repository this needs not being there,
named with the file and, where a line is what to go fix, the line - and any `wrote` line already
printed still stands, because the unusable file can be a layer this command never touched; 2 the
line as typed does not parse, which is argparse's own code for it.
"""

import argparse
import collections
import functools
import math
import os
import subprocess
import sys
from pathlib import Path

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(
    os.path.abspath(__file__)))))
# A plugin is a directory rather than an installed package, so the path comes before the import.
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "lib"))
from ceiling_config import (CONFIG_NAME, PROJECT_CONFIG_DIR, SHARED_AT_START,  # noqa: E402
                            USER_CONFIG, Written, anchored, ceiling_in, committed, folded,
                            in_force, live_shared, project_file, session_directory,
                            shared_unrecorded, staging)

SESSION_VARIABLE = "CLAUDE_CODE_SESSION_ID"
ANCHOR = anchored(os.getcwd())
# `set` is the one command that takes a value, third token of the line, and that value is the one
# token of this grammar that may begin with `-`.
VALUE_TAKING, VALUE_AT = "set", 2
# The tokens that can stand in the value slot and not be a value: a request for help is a request
# for help wherever it is typed.
HELP_FLAGS = ("-h", "--help")
# What a move starts from, the files that receive it, and the files a clear takes away.
Scope = collections.namedtuple("Scope", "beneath writes clears")


def tokens(ceiling):
    """One resolved ceiling as a person reads it, which is not how a config file holds it: the
    file format is `ceiling_config.render`, and these two renderings answer to different readers."""
    return "no ceiling" if ceiling == math.inf else f"{ceiling:,} tokens"


def this_session():
    """The directory holding this session's config layers.

    [LAW:parse-dont-validate] the crossing from an environment that might not name a session to a
    directory that does. Every command below needs it, because every ceiling is some session's, so
    the absence is refused once here rather than guarded at each path that gets built from it."""
    named = os.environ.get(SESSION_VARIABLE)
    if not named:
        sys.exit(f"ceiling: {SESSION_VARIABLE} is not set, so this command cannot tell whose "
                 f"ceiling to move. Run it from inside a Claude Code session.")
    return session_directory(named)


def asked_of_git(anchor, question):
    """One path git answers about the checkout the anchor stands in, empty where it has no answer.

    Asked from the anchor and not from this process's own directory, which is the same reason
    every other lookup here takes one: a `cd` anywhere in the session must not decide which
    repository receives the file. [LAW:one-source-of-truth] an anchor that is not a directory at
    all raises, and lands in the arm below with the rest of git's unavailability."""
    try:
        done = subprocess.run(["git", "rev-parse", "--path-format=absolute", question],
                              capture_output=True, text=True, cwd=anchor)
    except OSError as failure:
        sys.exit(f"ceiling: cannot run git to find the project root: {failure}")
    if done.returncode != 0:
        sys.exit(f"ceiling: {anchor} is not inside a git repository, so there is no project "
                 f"root to write a project ceiling to. Move this session's own ceiling instead, "
                 f"or write {PROJECT_CONFIG_DIR}/{CONFIG_NAME} yourself in whichever directory "
                 f"you mean by the project.")
    return done.stdout.strip()


def repository_root(anchor):
    """The root of the checkout the anchor stands in, which is where a project ceiling goes when
    no project config stands yet.

    Two checkouts can be standing at one anchor and they want different roots, so which one this is
    is git's question to answer rather than a shape to read off the path. A linked worktree wants
    the checkout it belongs to, which is what the *common* dir names: a file at a worktree's own
    root would govern that worktree until it is deleted, and the project is what the person meant.
    That root is also the one directory every subdirectory and every nested worktree walks up
    through, which is what makes the hook find it from wherever a later session stands.

    A submodule wants its own root, and the common dir is no route to it: the superproject keeps a
    submodule's git dir at `.git/modules/<name>`, whose parent is inside git's own storage - a
    directory no walk up from the submodule ever passes through. A file written there would be
    reported as written and would govern nothing. [LAW:no-silent-failure]"""
    if asked_of_git(anchor, "--show-superproject-working-tree"):
        return Path(asked_of_git(anchor, "--show-toplevel"))
    return Path(asked_of_git(anchor, "--git-common-dir")).parent


def project_write_site(anchor):
    """The project config a project-scoped move writes: the one already in force here, else a new
    one at the repository root.

    Writing the file already in force is what keeps a second one from appearing deeper in the
    tree, where the hook's walk would reach it first and two files would claim one ceiling.
    [LAW:one-source-of-truth] Where none stands, a file left in whatever subdirectory the command
    ran from would govern that subtree and silently not the project, so the root is the site."""
    return project_file(anchor) or repository_root(anchor) / PROJECT_CONFIG_DIR / CONFIG_NAME


def session_beneath(directory, anchor):
    """What a session-scoped move starts from: the ceiling this session is running under now, so
    `+100_000` means a hundred thousand more than it has."""
    return in_force(directory, shared_unrecorded(directory / SHARED_AT_START, anchor))


def session_layer(directory, anchor):
    """The file a session-scoped move writes and a session-scoped clear removes: this session's
    own layer, which outlives nothing. One answer to both questions, because a session's layer is
    created exactly where it is removed."""
    return [directory / CONFIG_NAME]


def project_beneath(directory, anchor):
    """What a project-scoped move starts from: what this project resolves to for a session
    starting now.

    Not what this session is running under. A session that gave itself extra room would otherwise
    smuggle that allowance into the project's own number, and the project would end up stating a
    ceiling that was only ever one session's business."""
    return live_shared(anchor)


def project_writes(directory, anchor):
    """The files a project-scoped move writes: the project's layer and this session's own.

    This session's layer is written because the user and project layers were frozen for it at its
    first stop, into the record the hook keeps - so the project file alone moves the ceiling for
    every session after this one and not for the session that asked. That is the whole of why a
    project change needs a second write, and it is why both files receive the same resolved
    number rather than the same adjustment: an absolute ignores the layers beneath it, so the two
    files cannot drift into stating different ceilings however the shared layers later move."""
    return [project_write_site(anchor), directory / CONFIG_NAME]


def project_clears(directory, anchor):
    """The files a project-scoped clear removes: the project config in force where one stands, and
    this session's own layer.

    Where no project config stands there is nothing to remove and no site to name. Asked of the
    write site instead, a clear would ask git for a repository root it has no use for, and refuse
    to do nothing outside a repository - with a message about writing. Which files exist to be
    taken away and where a new one would be created are two questions, and the repository is an
    answer only the second one needs. [LAW:decomposition]"""
    return [path for path in (project_file(anchor), directory / CONFIG_NAME) if path]


SCOPES = {"session": Scope(beneath=session_beneath, writes=session_layer, clears=session_layer),
          "project": Scope(beneath=project_beneath, writes=project_writes, clears=project_clears)}


def layer(label, path, absent):
    """One layer of the report: the ceiling its file holds, and the file holding it. A layer that
    holds nothing still prints - which layers are empty is half of what a reader came to find
    out, and a report that listed only the layers in play would make the default look unset."""
    holding = ceiling_in(path) if path else None
    print(f"  {label:<18}{holding.text if holding else absent:<14} {path or ''}".rstrip())


def report(directory, anchor):
    """The ceiling in force, the ceiling a new session here would get, and the layer behind each.

    The last word of every command, including the ones that changed nothing, so a write that is
    not reflected here did not happen and nothing else has to be consulted to learn that. The two
    numbers are printed together because a project-scoped write has to land on both, and seeing
    them agree is the whole verification. [LAW:verifiable-goals]"""
    record = directory / SHARED_AT_START
    print(f"this session        {tokens(in_force(directory, shared_unrecorded(record, anchor)))}")
    layer("shared at start", record, "(not recorded)")
    layer("session layer", directory / CONFIG_NAME, "(unset)")
    print(f"a new session here  {tokens(live_shared(anchor))}")
    layer("project layer", project_file(anchor), "(none)")
    layer("user layer", USER_CONFIG, "(unset)")


def held(path):
    """What one config file says now, for a line about to replace or remove it, or None for a file
    that sets nothing.

    `ceiling_in` answers a file it cannot read by ending the process, which is the right answer
    for every caller that needs a ceiling out of it and the wrong one for the two callers here:
    `clear` is the sanctioned way to remove a layer the hook is already dying on, and a reader
    that exits rather than answers leaves that file removable by nothing but hand. The refusal is
    borrowed and printed rather than worked around with a second parser, so there is still one
    grammar. [LAW:one-source-of-truth]

    Unreadable is wider than unparseable and the difference does not reach here: bytes that are not
    text, and a mode that forbids the read, stop that reader as surely as a key written twice does,
    and a file in any of those states is a file `clear` exists to take away. Each arrives as a
    different exception and none of them is an answer, so all of them are reported the one way -
    `UnicodeDecodeError` among them, a `ValueError` reached through neither of the others."""
    try:
        found = ceiling_in(path)
    except (SystemExit, OSError, UnicodeDecodeError) as refusal:
        return f"an unreadable setting - {refusal}"
    return found.text if found else None


def move(scope, request, directory, anchor):
    """Resolve one requested move against the ceiling beneath it and write it to every file the
    scope names.

    The same absolute number goes to every one of them. A signed request is a way of saying a
    number you do not want to look up, not a thing a file has to keep saying: resolved here once,
    it cannot be applied twice by two layers that both read it.

    Every file is staged before any of them lands, because the files one scope names have to state
    one number: a failure that can happen - no permission, no space - happens in the staging pass,
    where nothing is in place yet and the command exits having moved nothing. What each file held
    is printed as it is replaced, so a ceiling set for this session alone cannot vanish under a
    project-scoped move with no record of what it was.

    What each file held is also read a second time, and a file that no longer holds it stops the
    write. The project layer is shared - every session in the checkout reads it and, since this
    command exists, can write it - so two sessions adjusting it at once would otherwise both start
    from the same number and the later one would quietly drop the earlier one's change. A lock would
    bind only the writers that take it, and this file is documented as one a person may edit by
    hand, where no lock is taken; asking whether the number is still the one that was read covers
    that writer too. [LAW:verifiable-goals] Every destination is checked before any is committed, so
    a refusal cannot leave one file written and the other not.

    The request itself is resolved a second time, because what a write rests on is the number rather
    than the files it came out of, and those are not the same question: a signed request reads the
    layers beneath it, and some of those are nobody's destination - the user layer is in a
    project-scoped base and is never written here - so a base can move with every destination
    sitting still. Asking again is that question in the vocabulary the answer is in.
    [LAW:one-source-of-truth] It asks nothing that was not asked already: a count and `off` state a
    ceiling outright, so for them the second resolution opens no file and can refuse nothing."""
    asked = Written(f"the {request!r} you asked for", request)
    destinations = scope.writes(directory, anchor)
    base = functools.partial(scope.beneath, directory, anchor)
    standing = {path: held(path) for path in destinations}
    ceiling = folded([asked], beneath=base)
    with staging(destinations, ceiling) as partials:
        for path in destinations:
            now = held(path)
            if now != standing[path]:
                sys.exit(f"ceiling: {path} changed while this command was working out what to "
                         f"write - it held {standing[path] or 'no ceiling'} and now holds "
                         f"{now or 'no ceiling'}. Nothing was written, so that change stands; "
                         f"run this again if you still mean to move it.")
        resolved_again = folded([asked], beneath=base)
        if resolved_again != ceiling:
            sys.exit(f"ceiling: {request!r} resolved to {tokens(ceiling)} and then to "
                     f"{tokens(resolved_again)} while this command was working out what to write, "
                     f"a layer beneath it having changed in between. Nothing was written, so that "
                     f"change stands; run this again if you still mean to move it.")
        for path, partial in partials:
            replaced = f" (replacing {standing[path]})" if standing[path] else ""
            print(f"wrote {committed(partial, path).source}{replaced}")


def clear(scope, directory, anchor):
    """Remove every file the scope names, handing those layers back to the ones beneath them.

    What each file said is printed as it goes, so a ceiling someone meant to keep is recoverable
    from this command's own output rather than only from whoever remembers it. Read, removed, then
    reported, in that order: a line printed before the unlink would describe a removal that a
    permission error still had time to prevent.

    One removal at a time, with no staging and nothing held back: two writes are bound by having
    to state one number, and two removals are bound by nothing - a layer taken away hands its
    session or its project to the layer beneath, which is right on its own however the next
    removal goes.

    A `set` is the writer this is not bound against, and deliberately. The read sits next to the
    unlink with nothing in between, so the second read `move` has would straddle no work at all:
    there is no compare-and-unlink to be had, and a removal that lands one instruction later is the
    same removal. What it costs is the printed number, which is the one read an instant before the
    file went rather than the one taken away. Closing that would mean removing first and reporting
    from the file taken away, and then every message here would quote a `memento.conf.<pid>` that
    was never anybody's config - including the unreadable-layer line this printing exists for, where
    the path is the whole of what a person needs. [LAW:polishing-by-subtraction]"""
    for path in scope.clears(directory, anchor):
        standing = held(path)
        path.unlink(missing_ok=True)
        print(f"removed {path} (it held {standing})" if standing else f"absent  {path}")


def as_one_value(argv):
    """The command line with `set`'s value put where argparse cannot read it as an option.

    argparse decides whether a `-`-leading token is a value or an unrecognised option with a
    private regex whose shape changed in 3.13. Before that it matched plain digits only, so
    `-50_000` - the underscored form this grammar documents and accepts - was taken for an option,
    the value never reached `parse_ceiling`, and the command exited 2 on a usage error instead of
    moving the ceiling down. `--` states the same thing in a way every version of argparse and
    every shell already agrees about, and it goes in only ahead of the slot that holds a value.

    Except that one token standing there is not a value: `set <scope> -h` is someone asking what to
    type, and quoting it would answer with a complaint about a ceiling spelled `-h`. Naming the two
    help flags is narrower than asking whether the token looks like a number - that question is
    argparse's own private regex, and a second copy of it here is the thing this function exists to
    stop depending on. [LAW:parse-dont-validate] the ambiguity is settled before the parse rather
    than recovered from after it."""
    value = argv[VALUE_AT:]
    asking_help = bool(value) and value[0] in HELP_FLAGS
    return argv if argv[:1] != [VALUE_TAKING] or asking_help else [*argv[:VALUE_AT], "--", *value]


parser = argparse.ArgumentParser(
    prog="ceiling", description="Move the context ceiling for this session or its project.",
    epilog="A project-scoped change also writes this session's own layer, because the project "
           "layer was frozen for this session at its first stop. Both get the same resolved "
           "number. Clearing a project ceiling returns later sessions to the layer beneath it, "
           "and returns this one to the ceiling it started under.")
commands = parser.add_subparsers(dest="command", required=True)
commands.add_parser("show", help="print the ceiling in force and the files that set it")
# `choices` is the checkpoint: past the parse a scope is one of two known things, so nothing
# downstream asks again. [LAW:parse-dont-validate]
setting = commands.add_parser(VALUE_TAKING, help="write a ceiling to the layers a scope names")
setting.add_argument("scope", choices=sorted(SCOPES))
setting.add_argument("ceiling", metavar="off|N|+N|-N",
                    help="a count of tokens, a signed adjustment to the ceiling beneath, "
                         "or off to lift the ceiling entirely")
clearing = commands.add_parser("clear", help="remove the layers a scope names")
clearing.add_argument("scope", choices=sorted(SCOPES))

args = parser.parse_args(as_one_value(sys.argv[1:]))
directory = this_session()
# Every command ends in the same report, and the two that change something run one step before it.
# [LAW:dataflow-not-control-flow] the set of operations does not vary; what varies is the data.
# [LAW:single-enforcer] one place turns a filesystem that said no into this command's own refusal.
# Every read, write and unlink below can raise one; the exit contract above promises the file and
# the reason, and a traceback is that promise broken for the agent reading stderr for `ceiling: `.
# The errno message carries both, so there is nothing to add to it. [LAW:effects-at-boundaries]
try:
    {"show": lambda: None,
     VALUE_TAKING: lambda: move(SCOPES[args.scope], args.ceiling, directory, ANCHOR),
     "clear": lambda: clear(SCOPES[args.scope], directory, ANCHOR)}[args.command]()
    report(directory, ANCHOR)
except OSError as refusal:
    sys.exit(f"ceiling: {refusal}")
