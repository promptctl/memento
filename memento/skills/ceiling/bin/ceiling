#!/usr/bin/env python3
"""Moves the context ceiling: writes the config layers a scope names and reports what is in force.

The grammar and fold order live in `lib/ceiling_config.py`, which writes every file through and reads
it back. A scope names the ceiling a move starts from, the files it writes, and the files a clear
removes, and every command runs the same steps over that data. Each command also updates the
cc-candybar plugin and this session's status (`lib/candybar.py`). Exit codes: 0 the files say what
was printed; 1 the ceiling cannot be written or read, with the file and line named, and any `wrote`
line already printed stands; 2 the command line does not parse; 3 the files are updated but the
cc-candybar status could not be written.
"""

import argparse
import collections
import functools
import math
import os
import subprocess
import sys
from pathlib import Path

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(
    os.path.abspath(__file__)))))
# A plugin is a directory rather than an installed package, so the path comes before the import.
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "lib"))
from ceiling_config import (CONFIG_NAME, PROJECT_CONFIG_DIR, USER_CONFIG,  # noqa: E402
                            Written, anchored, ceiling_in, committed, folded, in_force,
                            live_shared, project_file, session_directory, staging)
from candybar import publish  # noqa: E402
from ceiling_log import reason_of  # noqa: E402
from git_at import git_at  # noqa: E402

SESSION_VARIABLE = "CLAUDE_CODE_SESSION_ID"
ANCHOR = anchored(os.getcwd())
# `set` takes a value as its third token. That value is the only token that may begin with `-`.
VALUE_TAKING, VALUE_AT = "set", 2
# A help flag in the value slot is a request for help, not a value.
HELP_FLAGS = ("-h", "--help")
# What a move starts from, the files that receive it, and the files a clear takes away.
Scope = collections.namedtuple("Scope", "beneath writes clears")


def tokens(ceiling):
    """Returns a resolved ceiling as a person reads it. Config files use the format `ceiling_config.render` writes."""
    return "no ceiling" if ceiling == math.inf else f"{ceiling:,} tokens"


def this_session():
    """Returns the directory holding this session's config layers. Exits if no session is named.

    Every command needs it, so the check is made once here."""
    named = os.environ.get(SESSION_VARIABLE)
    if not named:
        sys.exit(f"ceiling: {SESSION_VARIABLE} is not set, so this command cannot tell whose "
                 f"ceiling to move. Run it from inside a Claude Code session.")
    return session_directory(named)


def asked_of_git(anchor, question):
    """Returns the path git reports for `question`, relative to the anchor, or None if git reports nothing.

    git runs about the anchor rather than this process's directory or an inherited GIT_DIR, so
    neither a `cd` in the session nor a git hook's environment can change the repository. Older git
    versions echo an unknown option back as output, so an answer that repeats the question is
    refused instead of being used as a path."""
    try:
        done = git_at(anchor, "rev-parse", question)
    except OSError as failure:
        sys.exit(f"ceiling: cannot run git to find the project root: {failure}")
    except subprocess.CalledProcessError as failure:
        sys.exit(f"ceiling: git cannot list the variables that name a repository, so it cannot be "
                 f"asked which project {anchor} is in: {failure.stderr.strip()}")
    if done.returncode != 0:
        sys.exit(f"ceiling: git could not say where the project is, asked from {anchor}: "
                 f"{done.stderr.strip()}\nIf that is because this is not a git repository, there "
                 f"is no root to write a project ceiling to: move this session's own ceiling "
                 f"instead, or write {PROJECT_CONFIG_DIR}/{CONFIG_NAME} yourself in whichever "
                 f"directory you mean by the project.")
    answered = [line for line in done.stdout.splitlines() if line.strip()]
    if question in answered:
        sys.exit(f"ceiling: the git on this PATH answers `{question}` by handing it back, which "
                 f"means it does not know that question and cannot say which repository a new "
                 f"project config belongs in. Upgrade git, or write "
                 f"{PROJECT_CONFIG_DIR}/{CONFIG_NAME} yourself in whichever directory you mean by "
                 f"the project.")
    return (Path(anchor) / answered[0]).resolve() if answered else None


def repository_root(anchor):
    """Returns the root where a project config goes for the checkout at the anchor.

    A linked worktree uses the root of the checkout it belongs to, since a file at the worktree's own
    root would apply only until that worktree is deleted. A submodule uses its own root, because its
    git common dir lies in the superproject's storage, which no walk up from the submodule reaches."""
    if asked_of_git(anchor, "--show-superproject-working-tree"):
        return asked_of_git(anchor, "--show-toplevel")
    return asked_of_git(anchor, "--git-common-dir").parent


def project_write_site(anchor):
    """Returns the project config a project-scoped move writes: the one in force, or a new one at the repository root.

    Writing the existing file keeps a second one from appearing deeper in the tree and claiming the
    same ceiling. A new file goes at the root, because one in a subdirectory would govern only that subtree."""
    return project_file(anchor) or repository_root(anchor) / PROJECT_CONFIG_DIR / CONFIG_NAME


def session_beneath(directory, anchor):
    """Returns the ceiling this session currently runs under, which a session-scoped adjustment is applied to."""
    return in_force(directory, anchor)


def session_layer(directory, anchor):
    """Returns the session's own layer file, which both session-scoped writes and clears use."""
    return [directory / CONFIG_NAME]


def project_beneath(directory, anchor):
    """Returns what this project resolves to for a session starting now, which project-scoped moves start from.

    It excludes this session's own layer, so a session's extra allowance does not leak into the project's number."""
    return live_shared(anchor)


def project_writes(directory, anchor):
    """Returns the project layer file, which the hook reads at every stop."""
    return [project_write_site(anchor)]


def project_clears(directory, anchor):
    """Returns the project config in force, or an empty list if none exists.

    A clear needs no repository root, since it only removes an existing file."""
    return [path for path in (project_file(anchor),) if path]


SCOPES = {"session": Scope(beneath=session_beneath, writes=session_layer, clears=session_layer),
          "project": Scope(beneath=project_beneath, writes=project_writes, clears=project_clears)}


def layer(label, path, absent):
    """Prints one layer's ceiling and file. Empty layers are printed too, so the report shows the full stack."""
    holding = ceiling_in(path) if path else None
    print(f"  {label:<18}{holding.text if holding else absent:<14} {path or ''}".rstrip())


def report(directory, anchor):
    """Prints the ceiling in force, the ceiling a new session would get, and each layer.

    This is the last output of every command, so it shows what the next stop will resolve."""
    print(f"this session        {tokens(in_force(directory, anchor))}")
    layer("session layer", directory / CONFIG_NAME, "(unset)")
    print(f"a new session here  {tokens(live_shared(anchor))}")
    layer("project layer", project_file(anchor), "(none)")
    layer("user layer", USER_CONFIG, "(unset)")


def held(path):
    """Returns what one config file says now, or None if it sets nothing.

    An unreadable file is returned as a message instead of exiting, so `clear` can still remove it. The
    message comes from `ceiling_in`, so the grammar is not duplicated here."""
    try:
        found = ceiling_in(path)
    except (SystemExit, OSError) as refusal:
        return f"an unreadable setting - {refusal}"
    return found.text if found else None


def move(scope, request, directory, anchor):
    """Resolves one move against the ceiling beneath it and writes the result to the scope's files.

    The resolved absolute number is written, so a signed request is not applied again on later reads.
    Files are staged before any is replaced, and each is checked to still hold the value that was read,
    since shared layers can change during the command. The request is resolved again just before
    writing, because a layer beneath it may have changed in the meantime; a count or `off` does not
    depend on that layer, so its second resolution opens no file."""
    asked = Written(f"the {request!r} you asked for", request)
    destinations = scope.writes(directory, anchor)
    base = functools.partial(scope.beneath, directory, anchor)
    standing = {path: held(path) for path in destinations}
    ceiling = folded([asked], beneath=base)
    with staging(destinations, ceiling) as partials:
        for path in destinations:
            now = held(path)
            if now != standing[path]:
                sys.exit(f"ceiling: {path} changed while this command was working out what to "
                         f"write - it held {standing[path] or 'no ceiling'} and now holds "
                         f"{now or 'no ceiling'}. Nothing was written, so that change stands; "
                         f"run this again if you still mean to move it.")
        resolved_again = folded([asked], beneath=base)
        if resolved_again != ceiling:
            sys.exit(f"ceiling: {request!r} resolved to {tokens(ceiling)} and then to "
                     f"{tokens(resolved_again)} while this command was working out what to write, "
                     f"a layer beneath it having changed in between. Nothing was written, so that "
                     f"change stands; run this again if you still mean to move it.")
        for path, partial in partials:
            replaced = f" (replacing {standing[path]})" if standing[path] else ""
            print(f"wrote {committed(partial, path).source}{replaced}")


def clear(scope, directory, anchor):
    """Removes each file the scope names, printing what each held.

    Each file is read, removed, then reported, so a line is not printed for a removal that failed. No
    staging is needed, since removing a layer hands its scope to the layer beneath it."""
    for path in scope.clears(directory, anchor):
        standing = held(path)
        path.unlink(missing_ok=True)
        print(f"removed {path} (it held {standing})" if standing else f"absent  {path}")


def as_one_value(argv):
    """Returns argv with `--` placed before `set`'s value, so argparse reads a negative value as a value.

    Some argparse versions take `-50_000` for an option. Help flags are left alone, so `set <scope> -h`
    still prints help."""
    value = argv[VALUE_AT:]
    asking_help = bool(value) and value[0] in HELP_FLAGS
    return argv if argv[:1] != [VALUE_TAKING] or asking_help else [*argv[:VALUE_AT], "--", *value]


parser = argparse.ArgumentParser(
    prog="ceiling", description="Move the context ceiling for this session or its project.",
    epilog="Every layer is read live at each stop, so a change to the project layer reaches this "
           "session at its next stop and every later session alike. A session-scoped change is "
           "this session's alone and is dropped when the session resets, /clear included.")
commands = parser.add_subparsers(dest="command", required=True)
commands.add_parser("show", help="print the ceiling in force and the files that set it")
# `choices` limits the scope to the known scopes, so later code does not check again.
setting = commands.add_parser(VALUE_TAKING, help="write a ceiling to the layers a scope names")
setting.add_argument("scope", choices=sorted(SCOPES))
setting.add_argument("ceiling", metavar="off|N|+N|-N",
                    help="a count of tokens, a signed adjustment to the ceiling beneath, "
                         "or off to lift the ceiling entirely")
clearing = commands.add_parser("clear", help="remove the layers a scope names")
clearing.add_argument("scope", choices=sorted(SCOPES))

args = parser.parse_args(as_one_value(sys.argv[1:]))
directory = this_session()
# Every command ends with the same report. The cc-candybar status is written after the step even if
# the step failed, and a failure to write it is reported on its own line with exit code 3.
def publishing():
    try:
        print("cc-candybar  " + " ".join(f"{k}={v}" for k, v in publish(directory, ANCHOR).items()))
        return None
    except Exception as failure:
        print(f"ceiling: cc-candybar status not written: {reason_of(failure)}", file=sys.stderr)
        return 3


try:
    try:
        {"show": lambda: None,
         VALUE_TAKING: lambda: move(SCOPES[args.scope], args.ceiling, directory, ANCHOR),
         "clear": lambda: clear(SCOPES[args.scope], directory, ANCHOR)}[args.command]()
    finally:
        unpublished = publishing()
    report(directory, ANCHOR)
except OSError as refusal:
    sys.exit(f"ceiling: {refusal}")
sys.exit(unpublished)
