#!/bin/sh
# memento's commands by name, for a caller outside Claude Code, where no
# ${CLAUDE_PLUGIN_ROOT} says where they are: cc-candybar runs `ceiling` through
# the launcher memento's hooks install beside its plugin (lib/candybar.py).
# Exit 2 for a command memento has none of, argparse's code for a line that
# does not parse.
root=$(cd "$(dirname "$0")/.." && pwd) || exit 1
case "$1" in
  ceiling) shift; exec "$root/skills/ceiling/bin/ceiling" "$@" ;;
  *) echo "memento: no command ${1:-(none given)}; memento runs: ceiling" >&2; exit 2 ;;
esac
