// memento's cc-candybar plugin: the session's context ceiling on the bar, and
// the moves that change it. memento's hooks install this folder, as
// $XDG_DATA_HOME/cc-candybar/plugins/memento/, and write
// `session/<session id>.json` there, the file the `status` source reads, at
// every stop and session start and after every `ceiling` command
// (memento/lib/candybar.py). Placed as `plugins.memento.ceiling`. Of two
// mementos installing it, the newer one's copy stands, so this definition
// reads the status of every older memento.
{
  sources: {
    // { home, command, ceiling: <tokens> | "off", session: <the session
    // layer> | null }, or { home, command, refusal } when a layer memento's
    // reader refuses has stopped its gate. `home` is the config home memento
    // resolved for the session and `command` the `ceiling` command of the
    // memento install the session runs, both handed to each move, so a click
    // runs that session's memento over the layers its gate reads.
    status: {
      scope: "session",
      refresh: { watch: true },
      read: { file: { json: true } },
    },
  },
  segments: {
    // Beside `context` wherever it stands, since the two numbers are read
    // against each other. − shows only above 100K: below it the move is
    // refused, and at it the move sets a ceiling of 0, which ends every turn
    // in a hand-off. ↺ shows only while the session has a layer to drop, or beside a
    // refusal, where dropping the session's layer may restore the gate.
    ceiling: {
      group: "model-context",
      description: "memento's context ceiling for this session: − and + move it by 100K, ∞ lifts it, ↺ drops this session's own setting.",
      // No file until memento has written one for this session.
      when: '{{ hasKey .plugins.memento "status" }}',
      template: '{{ with .plugins.memento.status }}⌈ {{ if hasKey . "refusal" }}⚠ {{ .refusal }} {{ action "plugins.memento.clear" "↺" }}{{ else }}{{ if eq (toString .ceiling) "off" }}off{{ else }}{{ template "formatTokenCount" .ceiling }} {{ if gt .ceiling 100000 }}{{ action "plugins.memento.lower" "−" }} {{ end }}{{ action "plugins.memento.raise" "+" }} {{ action "plugins.memento.off" "∞" }}{{ end }}{{ if .session }} {{ action "plugins.memento.clear" "↺" }}{{ end }}{{ end }}{{ end }}',
      // A refusal means memento's gate is off for this session until someone
      // fixes the file it names.
      bg: '{{ if hasKey .plugins.memento.status "refusal" }}{{ color "error" }}{{ else }}{{ tint }}{{ end }}',
    },
  },
  // Each move is the session's own memento's `ceiling` command on the
  // session's layer, with memento's own value grammar. cc-candybar runs it for the clicked session,
  // setting CLAUDE_CODE_SESSION_ID and CLAUDE_PROJECT_DIR to that session's.
  actions: {
    raise: {
      run: ["{{ .plugins.memento.status.command }}", "set", "session", "+100_000"],
      env: { MEMENTO_CONFIG_HOME: "{{ .plugins.memento.status.home }}" },
      refreshes: ["status"],
    },
    lower: {
      run: ["{{ .plugins.memento.status.command }}", "set", "session", "-100_000"],
      env: { MEMENTO_CONFIG_HOME: "{{ .plugins.memento.status.home }}" },
      refreshes: ["status"],
    },
    off: {
      run: ["{{ .plugins.memento.status.command }}", "set", "session", "off"],
      env: { MEMENTO_CONFIG_HOME: "{{ .plugins.memento.status.home }}" },
      refreshes: ["status"],
    },
    clear: {
      run: ["{{ .plugins.memento.status.command }}", "clear", "session"],
      env: { MEMENTO_CONFIG_HOME: "{{ .plugins.memento.status.home }}" },
      refreshes: ["status"],
    },
  },
}
